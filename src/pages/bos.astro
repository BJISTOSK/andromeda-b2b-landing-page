---
import Layout from '../layouts/Layout.astro';
import BosConsole from '../components/BosConsole.astro';
---

<Layout
  title="BOS Operations Console | Andromeda Business Operating System"
  description="Andromeda BOS (Business Operating System) - Enterprise telemetry, autonomous service orchestration, and real-time Convex data streams."
  activePage="bos"
>
  <div class="bos-page-wrap">
    <!-- Top Hero Section (Cruip Style) -->
    <section class="bos-hero">
      <div class="container text-center">
        <div class="hero-top-row">
          <div class="pill-badge">
            <span class="status-dot status-dot-active"></span>
            <span class="pill-highlight">Enterprise Grade</span>
            <span>&bull; Real-Time Telemetry</span>
          </div>
          <div class="edge-indicator">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Cloudflare Global Edge CDN Active</span>
          </div>
        </div>

        <h1 class="page-title">
          Andromeda <span class="gradient-text">BOS Console</span>
        </h1>
        <p class="page-subtitle">
          The centralized Business Operating System. Monitor distributed enterprise nodes, trigger live cluster synchronizations, and observe reactive data streams powered by Convex.
        </p>
      </div>
    </section>

    <!-- Main Console Component -->
    <section class="console-section">
      <div class="container">
        <BosConsole />
      </div>
    </section>

    <!-- Architecture & Developer Integration Notes (Cruip Card) -->
    <section class="dev-notes-section">
      <div class="container">
        <div class="cruip-card notes-box">
          <div class="notes-header">
            <div class="pill-badge mb-2">
              <span class="pill-highlight">Convex Stack</span>
              <span>&bull; Reactive Backend Architecture</span>
            </div>
            <h3 class="notes-title">How BOS Interfaces with Convex</h3>
          </div>

          <div class="grid-3 notes-grid">
            <div class="note-item">
              <h4>1. Schema-Gated Queries</h4>
              <p>
                Telemetry is validated against strict enterprise contracts for operations, tasks, and live metrics.
              </p>
            </div>

            <div class="note-item">
              <h4>2. Reactive WebSocket Subscriptions</h4>
              <p>
                Backend mutations instantly broadcast state changes to all connected enterprise clients without polling.
              </p>
            </div>

            <div class="note-item">
              <h4>3. Isolated Static Delivery</h4>
              <p>
                The BOS front-end compiles to static HTML/CSS/JS via Astro and deploys to Cloudflare Pages edge CDN, eliminating server bottlenecks.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bos-page-wrap {
    padding-bottom: 6rem;
  }

  .bos-hero {
    padding: 3.5rem 0 1.5rem;
  }

  .text-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .edge-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    box-shadow: var(--shadow-xs);
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .page-subtitle {
    color: var(--text-secondary);
    max-width: 720px;
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .console-section {
    padding: 1rem 0;
  }

  .dev-notes-section {
    padding: 2rem 0;
  }

  .notes-box {
    padding: 2.75rem;
  }

  .notes-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .mb-2 {
    margin-bottom: 0.5rem;
    align-self: flex-start;
  }

  .notes-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .notes-grid {
    gap: 2rem;
  }

  .note-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background-color: #f8fafc;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .note-item h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .note-item p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero-top-row {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    .notes-box {
      padding: 2rem 1.5rem;
    }
    .notes-header .mb-2 {
      align-self: center;
    }
    .notes-title {
      text-align: center;
    }
  }
</style>
