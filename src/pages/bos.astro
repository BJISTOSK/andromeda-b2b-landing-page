---
import Layout from '../layouts/Layout.astro';
import BosConsole from '../components/BosConsole.astro';
---

<Layout
  title="BOS Operations Console | Andromeda Business Operating System"
  description="Andromeda BOS (Business Operating System) - Enterprise telemetry, autonomous service orchestration, and real-time Convex data streams."
  activePage="bos"
>
  <div class="bos-page-wrap">
    <!-- Top Hero Section -->
    <section class="bos-hero">
      <div class="container">
        <div class="hero-top-row">
          <div class="badge badge-emerald">
            <span class="status-dot status-dot-active"></span>
            Enterprise Grade &bull; Real-Time Telemetry
          </div>
          <div class="edge-indicator">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Cloudflare Global Edge CDN Active</span>
          </div>
        </div>

        <h1 class="page-title">
          Andromeda <span class="gradient-text">BOS Console</span>
        </h1>
        <p class="page-subtitle">
          The centralized Business Operating System. Monitor distributed enterprise nodes, trigger live cluster synchronizations, and observe reactive data streams powered by Convex.
        </p>
      </div>
    </section>

    <!-- Main Console Component -->
    <section class="console-section">
      <div class="container">
        <BosConsole />
      </div>
    </section>

    <!-- Architecture & Developer Integration Notes -->
    <section class="dev-notes-section">
      <div class="container">
        <div class="glass-card notes-box">
          <div class="notes-header">
            <div class="badge badge-cyan">Convex Backend Architecture</div>
            <h3>How BOS Interfaces with Convex</h3>
          </div>

          <div class="grid-3 notes-grid">
            <div class="note-item">
              <h4>1. Schema-Gated Queries</h4>
              <p>
                Telemetry is validated against strict enterprise contracts for operations, tasks, and live metrics.
              </p>
            </div>

            <div class="note-item">
              <h4>2. Reactive WebSocket Subscriptions</h4>
              <p>
                Backend mutations instantly broadcast state changes to all connected enterprise clients without polling.
              </p>
            </div>

            <div class="note-item">
              <h4>3. Isolated Static Delivery</h4>
              <p>
                The BOS front-end compiles to static HTML/CSS/JS via Astro and deploys to Cloudflare Pages edge CDN, eliminating server bottlenecks.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bos-page-wrap {
    padding-bottom: 6rem;
  }

  .bos-hero {
    padding: 3.5rem 0 1rem;
  }

  .hero-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .edge-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    color: #94a3b8;
    max-width: 720px;
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .console-section {
    padding: 1rem 0;
  }

  .dev-notes-section {
    padding: 2rem 0;
  }

  .notes-box {
    padding: 2.75rem;
  }

  .notes-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .notes-header h3 {
    font-size: 1.5rem;
  }

  .notes-grid {
    gap: 2rem;
  }

  .note-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .note-item h4 {
    font-size: 1.05rem;
    color: #f1f5f9;
  }

  .note-item p {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .note-item code {
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent-cyan);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .hero-top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .notes-box {
      padding: 2rem 1.5rem;
    }
  }
</style>
