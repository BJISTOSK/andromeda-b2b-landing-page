---
import Layout from '../layouts/Layout.astro';
import PitchForm from '../components/PitchForm.astro';
---

<Layout
  title="Startups Pitch Portal | Andromeda B2B Venture Track"
  description="Submit your startup pitch deck to the Andromeda Venture Acceleration Track. Powered by a reactive Convex backend with enterprise dealflow evaluation."
  activePage="pitch"
>
  <div class="pitch-page-wrap">
    <!-- Header Hero Banner (Cruip Style) -->
    <section class="pitch-hero">
      <div class="container text-center">
        <div class="pill-badge mb-3">
          <span class="pill-highlight">Venture Track</span>
          <span>&bull; Dealflow Acceleration</span>
        </div>
        <h1 class="page-title">
          Andromeda <span class="gradient-text">Startups Pitch</span>
        </h1>
        <p class="page-subtitle">
          Accelerating the next cohort of enterprise B2B unicorns. Submit your pitch deck directly into our reactive evaluation pipeline.
        </p>

        <!-- Track Cards (Cruip Style) -->
        <div class="grid-4 tracks-grid">
          <div class="cruip-card track-card">
            <div class="track-badge badge-blue">Track 01</div>
            <h4>Pre-Seed Fast Track</h4>
            <p>For technical founders with an MVP or proprietary protocol. Up to $500k check.</p>
            <span class="track-focus">Focus: DeepTech & Infrastructure</span>
          </div>

          <div class="cruip-card track-card">
            <div class="track-badge badge-indigo">Track 02</div>
            <h4>Seed Acceleration</h4>
            <p>For early revenue startups ready to scale enterprise distribution. Up to $2.5M check.</p>
            <span class="track-focus">Focus: B2B SaaS & Liquidity</span>
          </div>

          <div class="cruip-card track-card">
            <div class="track-badge badge-cyan">Track 03</div>
            <h4>Enterprise Pilot</h4>
            <p>Direct commercial co-development and integration with Fortune 500 partners.</p>
            <span class="track-focus">Focus: Cloud & AI Ops</span>
          </div>

          <div class="cruip-card track-card">
            <div class="track-badge badge-pink">Track 04</div>
            <h4>Growth Syndicate</h4>
            <p>Series A & beyond syndication with top-tier global venture partners.</p>
            <span class="track-focus">Focus: Global Commerce</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Pitch Application Form Section -->
    <section class="form-section">
      <div class="container">
        <PitchForm />
      </div>
    </section>

    <!-- Evaluation Criteria FAQ (Cruip Card) -->
    <section class="criteria-section">
      <div class="container">
        <div class="cruip-card criteria-box">
          <div class="text-center mb-4">
            <div class="pill-badge mb-2">
              <span class="pill-highlight">Evaluation Matrix</span>
            </div>
            <h3 class="criteria-title">What Andromeda Looks For in Pitch Decks</h3>
          </div>
          <div class="grid-3 criteria-grid">
            <div class="crit-item">
              <div class="crit-num">01</div>
              <h4>Unfair Technical Edge</h4>
              <p>Proprietary architecture, defensible data moats, and high-performance infrastructure.</p>
            </div>
            <div class="crit-item">
              <div class="crit-num">02</div>
              <h4>B2B Enterprise Urgency</h4>
              <p>Demonstrated customer demand, clear contract velocity, and low customer acquisition cost.</p>
            </div>
            <div class="crit-item">
              <div class="crit-num">03</div>
              <h4>Ecosystem Synergy</h4>
              <p>Potential to leverage Andromeda BOS and liquidity protocols for mutual network expansion.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .pitch-page-wrap {
    padding-bottom: 6rem;
  }

  .pitch-hero {
    padding: 3.5rem 0 2rem;
  }

  .text-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 1rem 0;
    color: var(--text-primary);
  }

  .page-subtitle {
    color: var(--text-secondary);
    max-width: 680px;
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 3rem;
  }

  .tracks-grid {
    width: 100%;
    margin-bottom: 2rem;
  }

  .track-card {
    padding: 1.75rem 1.5rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .track-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 0.25rem;
  }

  .track-card h4 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .track-card p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    flex: 1;
  }

  .track-focus {
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
    font-weight: 500;
  }

  .form-section {
    padding: 1.5rem 0;
  }

  .criteria-section {
    padding: 3rem 0;
  }

  .criteria-box {
    padding: 3rem;
  }

  .mb-2 { margin-bottom: 0.5rem; }
  .mb-3 { margin-bottom: 1rem; }
  .mb-4 { margin-bottom: 2.5rem; }

  .criteria-title {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .criteria-grid {
    gap: 2rem;
  }

  .crit-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background-color: #f8fafc;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .crit-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand-blue);
  }

  .crit-item h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .crit-item p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .criteria-box {
      padding: 2rem 1.5rem;
    }
  }
</style>
