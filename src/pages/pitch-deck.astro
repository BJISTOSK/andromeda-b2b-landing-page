---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { pitchDeckArticles } from '../data/pitchDeckData';
import PitchDeepScanMatrix from '../components/pitch-deck/PitchDeepScanMatrix.astro';
import PitchMindMap from '../components/pitch-deck/PitchMindMap.astro';
import PitchHeatmapChart from '../components/pitch-deck/PitchHeatmapChart.astro';
import '../styles/library.css';
const categories = ['All', 'Foundations', 'Top Tier VCs', 'Data & Metrics', 'Stage-Specific'];
---
<Layout 
  title="The Pitch Deck Library & Deep Scan — Andromeda" 
  description="Deep scan diagnostics, interactive mind maps, investor attention heatmaps, and 12 battle-tested pitch deck frameworks." 
  activePage="pitch-deck"
>
  <div class="container library-page">
    <header class="library-header">
      <h1>Ideas worth backing.</h1>
      <div>
        <p>The intelligence engine behind Andromeda. Deep scan diagnostics, mind maps, and 12 battle-tested venture structures.</p>
        <span>Every framework unpacked with investor psychological criteria, slide-by-slide mind maps, and empirical DocSend attention heatmaps.</span>
        <div class="library-quick-jump">
          <a href="#deep-scan" class="text-link">Deep scan matrix <Arrow diagonal /></a>
          <a href="#mind-map" class="text-link">Pitch mind map <Arrow diagonal /></a>
          <a href="#attention-charts" class="text-link">Behavioral heatmaps <Arrow diagonal /></a>
          <a href="#directory" class="text-link">12 guides directory <Arrow diagonal /></a>
        </div>
      </div>
    </header>

    <div class="library-plate-card">
      <img 
        src="/images/the-wonderful-universe-explorer-the-great-36.jpg" 
        alt="1902 archival photograph of the Great Equatorial Telescope at Lick Observatory" 
        class="library-hero-image"
        width="1344"
        height="440"
        loading="lazy"
      />
      <div class="library-plate-caption">
        <span>Archival plate · The 36-inch Great Equatorial instrument, Lick Observatory (1902). Twelve frameworks for deep perspective.</span>
      </div>
    </div>

    <!-- Section 1: Deep Scan Matrix -->
    <section id="deep-scan" aria-label="12-Framework Deep Scan Matrix">
      <PitchDeepScanMatrix />
    </section>

    <!-- Section 2: Universal Pitch Mind Map -->
    <section id="mind-map" aria-label="Universal Pitch Deck Mind Map">
      <PitchMindMap />
    </section>

    <!-- Section 3: Empirical Attention Heatmaps & Sizing Charts -->
    <section id="attention-charts" aria-label="Behavioral Attention Heatmaps and SaaS Metrics">
      <PitchHeatmapChart />
    </section>

    <section class="archive-plates-row" aria-label="Observatory reference plates">
      <div class="archive-plate-item">
        <img src="/images/1750-star-chart-of-the-constellations-libra.jpg" alt="1750 Celestial Atlas by John Bevis" width="420" height="260" loading="lazy" />
        <span>Celestial Atlas · Structural Foundations</span>
      </div>
      <div class="archive-plate-item">
        <img src="/images/kitt-peak-national-observatory-beneath-star-trails.jpg" alt="Kitt Peak Observatory beneath star trails" width="420" height="260" loading="lazy" />
        <span>Kitt Peak Telemetry · Top Tier VC Trajectories</span>
      </div>
      <div class="archive-plate-item">
        <img src="/images/andromeda-galaxy.jpg" alt="M31 Andromeda galaxy archival plate" width="420" height="260" loading="lazy" />
        <span>Deep Space Plate · Stage-Specific Horizons</span>
      </div>
    </section>

    <section id="directory" class="framework-directory" aria-labelledby="directory-title">
      <div class="directory-top">
        <h2 id="directory-title">The frameworks <span>12 guides</span></h2>
        <div class="directory-search">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="m12 12 5 5"/></svg>
          <label for="article-search-input" class="sr-only">Search pitch frameworks</label>
          <input type="search" id="article-search-input" placeholder="Search by name, stage, or topic" autocomplete="off" />
          <button id="search-clear-btn" aria-label="Clear search" hidden>×</button>
        </div>
      </div>
      <div class="directory-controls">
        <div class="category-filters" role="group" aria-label="Filter frameworks by category">
          {categories.map((category,index) => (
            <button class:list={['filter-button', { active: index === 0 }]} aria-pressed={index === 0} data-category={category}>
              {category === 'All' ? 'All frameworks' : category}
              <span>{category === 'All' ? pitchDeckArticles.length : pitchDeckArticles.filter(article => article.category === category).length}</span>
            </button>
          ))}
        </div>
        <p id="result-count" aria-live="polite" aria-atomic="true">12 frameworks</p>
      </div>
      <div class="directory-grid" id="articles-grid">
        {pitchDeckArticles.map(article => (
          <a href={`/pitch-deck/${article.slug}`} class="framework-card" data-category={article.category} data-search={`${article.title} ${article.subtitle} ${article.desc} ${article.tags.join(' ')} ${article.stage}`.toLowerCase()}>
            <div class="framework-card-top">
              <span class="framework-category">{article.category}</span>
              <span class="framework-stage">{article.stage}</span>
            </div>
            <div class="framework-card-body">
              <h3>{article.title}</h3>
              <p>{article.desc}</p>
              <div class="framework-card-foot">
                <span>{article.readTime}</span>
                <Arrow diagonal />
              </div>
            </div>
          </a>
        ))}
      </div>
      <div id="no-results-box" class="empty-results" hidden>
        <h3>No matching frameworks</h3>
        <p>Try searching another firm name, venture stage, or topic.</p>
        <button id="reset-filters-btn" class="btn btn-primary">Reset filters <Arrow /></button>
      </div>
    </section>
    <aside class="library-closing">
      <span class="library-closing-note">A note for the founder</span>
      <p>The framework is a starting point. The story is yours.</p>
      <a href="/#explore" class="text-link">Find your next move <Arrow diagonal /></a>
    </aside>
  </div>
</Layout>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const targets = document.querySelectorAll('.library-header, .library-plate-card, .framework-directory, .framework-card, .library-closing');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    targets.forEach((el) => observer.observe(el));
  }
</script>
<script>
  const input = document.querySelector<HTMLInputElement>('#article-search-input');
  const clear = document.querySelector<HTMLButtonElement>('#search-clear-btn');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
  const cards = document.querySelectorAll<HTMLElement>('.framework-card');
  const empty = document.getElementById('no-results-box');
  const count = document.getElementById('result-count');
  let category = 'All';
  function applyFilters() {
    const query = input?.value.trim().toLowerCase() || '';
    let visible = 0;
    cards.forEach(card => {
      const matches = (category === 'All' || card.dataset.category === category) && (!query || (card.dataset.search || '').includes(query));
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (empty) empty.hidden = visible !== 0;
    if (clear) clear.hidden = !input?.value;
    if (count) count.textContent = `${visible} framework${visible === 1 ? '' : 's'}`;
  }
  filters.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category || 'All';
    filters.forEach(filter => { const selected = filter === button; filter.classList.toggle('active', selected); filter.setAttribute('aria-pressed', String(selected)); });
    applyFilters();
  }));
  input?.addEventListener('input', applyFilters);
  clear?.addEventListener('click', () => { if (input) input.value = ''; applyFilters(); input?.focus(); });
  document.getElementById('reset-filters-btn')?.addEventListener('click', () => { if (input) input.value = ''; filters[0].click(); input?.focus(); });
  // Preserve existing links to the original single-page article directory.
  const legacyArticle = window.location.hash.match(/^#article-(\d+)$/);
  if (legacyArticle) {
    const index = Number(legacyArticle[1]) - 1;
    const card = cards[index] as HTMLAnchorElement | undefined;
    if (card) window.location.replace(card.href);
  }
</script>
