---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { pitchDeckArticles } from '../data/pitchDeckData';
import '../styles/library.css';
const categories = ['All', 'Foundations', 'Top Tier VCs', 'Data & Metrics', 'Stage-Specific'];
---
<Layout title="The Pitch Library — Andromeda" description="Twelve practical pitch-deck frameworks. Explore the structure, storytelling, and metrics behind a clearer investor pitch." activePage="pitch-deck">
  <div class="container library-page">
    <div class="library-eyebrow"><span class="kicker">ANDROMEDA / THE FOUNDER'S LIBRARY</span><span class="kicker">12 FRAMEWORKS. ONE NEXT CHAPTER.</span></div>
    <header class="library-header"><h1>Ideas worth<br /><em>backing.</em></h1><div><p>Behind every great business is a story worth telling. Find the structure for yours.</p><span>Pitch frameworks from leading investors and accelerators, broken down into practical guides.</span><a href="/pitch-deck/6-slides-core-structure" class="text-link">New here? Start with the six essentials <Arrow diagonal /></a></div></header>
    <section class="framework-directory" aria-labelledby="directory-title">
      <div class="directory-top"><h2 id="directory-title">The frameworks <span>01—12</span></h2><div class="directory-search"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="m12 12 5 5"/></svg><label for="article-search-input" class="sr-only">Search pitch frameworks</label><input type="search" id="article-search-input" placeholder="Search by name, stage, or topic" autocomplete="off" /><button id="search-clear-btn" aria-label="Clear search" hidden>×</button></div></div>
      <div class="directory-controls"><div class="category-filters" role="group" aria-label="Filter frameworks by category">{categories.map((category,index) => <button class:list={['filter-button', { active: index === 0 }]} aria-pressed={index === 0} data-category={category}>{category === 'All' ? 'All frameworks' : category}<span>{category === 'All' ? pitchDeckArticles.length : pitchDeckArticles.filter(article => article.category === category).length}</span></button>)}</div><p id="result-count" aria-live="polite" aria-atomic="true">12 frameworks</p></div>
      <div class="directory-grid" id="articles-grid">{pitchDeckArticles.map((article,index) => <a href={`/pitch-deck/${article.slug}`} class="framework-card" data-category={article.category} data-search={`${article.title} ${article.subtitle} ${article.desc} ${article.tags.join(' ')} ${article.stage}`.toLowerCase()}><div class="framework-card-top"><span class="framework-number">{article.num}</span><span class="framework-category">{article.category}</span><span class:list={['framework-motif', `motif-${index % 3}`]} aria-hidden="true"></span></div><div class="framework-card-body"><span class="framework-stage">{article.stage}</span><h3>{article.title}</h3><p>{article.desc}</p><div class="framework-card-foot"><span>{article.readTime}</span><Arrow diagonal /></div></div></a>)}</div>
      <div id="no-results-box" class="empty-results" hidden><span class="kicker">NO MATCHES THIS TIME</span><h3>A different angle?</h3><p>Try another name, stage, or topic.</p><button id="reset-filters-btn" class="btn btn-primary">Reset filters <Arrow /></button></div>
    </section>
    <aside class="library-closing"><span class="kicker">A NOTE FOR THE FOUNDER</span><p>The framework is a starting point.<br /><em>The story is yours.</em></p><a href="/#explore" class="text-link">Find your next move <Arrow diagonal /></a></aside>
  </div>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#article-search-input');
  const clear = document.querySelector<HTMLButtonElement>('#search-clear-btn');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
  const cards = document.querySelectorAll<HTMLElement>('.framework-card');
  const empty = document.getElementById('no-results-box');
  const count = document.getElementById('result-count');
  let category = 'All';
  function applyFilters() {
    const query = input?.value.trim().toLowerCase() || '';
    let visible = 0;
    cards.forEach(card => {
      const matches = (category === 'All' || card.dataset.category === category) && (!query || (card.dataset.search || '').includes(query));
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (empty) empty.hidden = visible !== 0;
    if (clear) clear.hidden = !input?.value;
    if (count) count.textContent = `${visible} framework${visible === 1 ? '' : 's'}`;
  }
  filters.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category || 'All';
    filters.forEach(filter => { const selected = filter === button; filter.classList.toggle('active', selected); filter.setAttribute('aria-pressed', String(selected)); });
    applyFilters();
  }));
  input?.addEventListener('input', applyFilters);
  clear?.addEventListener('click', () => { if (input) input.value = ''; applyFilters(); input?.focus(); });
  document.getElementById('reset-filters-btn')?.addEventListener('click', () => { if (input) input.value = ''; filters[0].click(); input?.focus(); });
  // Preserve existing links to the original single-page article directory.
  const legacyArticle = window.location.hash.match(/^#article-(\d+)$/);
  if (legacyArticle) {
    const index = Number(legacyArticle[1]) - 1;
    const card = cards[index] as HTMLAnchorElement | undefined;
    if (card) window.location.replace(card.href);
  }
</script>
