            <span class="stat-metric-lbl">Average Attention Per Slide</span>
          </div>
          <div class="stat-metric-card">
            <span class="stat-metric-val">Bottom-Up</span>
            <span class="stat-metric-lbl">Mandatory TAM Formula</span>
          </div>
