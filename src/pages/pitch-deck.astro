    stage: "Idea / Pre-Seed",
    philosophy: "Jargon-Free One-Sentence Pitch",
    teamPlacement: "End of Deck",
    keyRequirement: "Zero superlatives ('best', 'first', 'only' are strictly forbidden)."
  }
