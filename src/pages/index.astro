---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import OrbitDiagram from '../components/home/OrbitDiagram.astro';
import ProductPreview from '../components/home/ProductPreview.astro';
import '../styles/home.css';
const perspectives = [
  { num: '01', title: 'The work.', text: 'Know what matters, who owns it, and what comes next.', tag: 'OPERATIONS' },
  { num: '02', title: 'The relationships.', text: 'Turn a network of partners into a connected business.', tag: 'COMMERCE' },
  { num: '03', title: 'The next chapter.', text: 'Build the story and the structure for your next stage.', tag: 'CAPITAL' },
];
const readings = [
  { num: '01', category: 'THE FOUNDATIONS', title: 'A stronger pitch starts with six clear answers.', text: 'The core structure behind an investor-ready story.', href: '6-slides-core-structure', shape: 'foundation', time: '10 MIN READ' },
  { num: '03', category: 'SEQUOIA CAPITAL', title: 'Clarity is your most valuable slide.', text: 'A closer look at the ten-slide Sequoia framework.', href: 'sequoia-capital-framework', shape: 'sequoia', time: '9 MIN READ' },
  { num: '04', category: 'Y COMBINATOR', title: 'Make the opportunity obvious.', text: 'The essentials of a convincing seed-stage deck.', href: 'y-combinator-seed-deck', shape: 'combinator', time: '8 MIN READ' },
];
---
<Layout title="Andromeda — Bring it all into orbit" description="A clearer perspective on your business. Explore connected operations, commercial relationships, and practical resources for your next stage." activePage="home">
  <section class="home-hero container" aria-labelledby="hero-title">
    <div class="hero-topline"><span class="kicker">A NEW PERSPECTIVE ON BUSINESS</span><span class="hero-edition">OPERATIONS / COMMERCE / CAPITAL</span></div>
    <div class="hero-grid">
      <div class="hero-copy"><h1 id="hero-title">Bring it all<br />into <span>orbit.</span></h1><p>Your work. Your relationships. Your next big move. A connected perspective for businesses going somewhere.</p><div class="hero-actions"><a class="btn btn-primary" href="#workspace">Explore the platform <Arrow diagonal /></a><a class="text-link" href="/pitch-deck">For the founders <Arrow /></a></div><div class="hero-footnote"><span class="crosshair" aria-hidden="true">+</span><span>LESS FRICTION.<br />MORE FORWARD.</span></div></div>
      <OrbitDiagram />
    </div>
    <div class="hero-bottomline"><span>BIG AMBITIONS NEED A CLEAR CENTRE.</span><a href="#approach">A different way to see your business <span aria-hidden="true">↓</span></a></div>
  </section>
  <section id="approach" class="approach-section container" aria-labelledby="approach-title"><div class="approach-intro"><span class="kicker">THE ANDROMEDA APPROACH</span><h2 id="approach-title">Good things happen<br />when things connect.</h2></div><div class="perspective-grid">{perspectives.map(item => <div class="perspective"><span class="perspective-number">{item.num} <span>↗</span></span><h3>{item.title}</h3><p>{item.text}</p><span class="perspective-tag">{item.tag}</span></div>)}</div></section>
  <ProductPreview />
  <section class="library-section container" aria-labelledby="library-title"><div class="section-heading"><span class="kicker">02 / THE FOUNDER'S LIBRARY</span><div class="heading-split"><h2 id="library-title">Big ideas.<br />Well articulated.</h2><div><p>Practical thinking for your next raise. Twelve pitch frameworks, unpacked and ready to put to work.</p><a href="/pitch-deck" class="text-link">Explore the full library <Arrow diagonal /></a></div></div></div><div class="reading-grid">{readings.map(article => <a href={`/pitch-deck/${article.href}`} class="reading-card"><div class:list={['reading-art', article.shape]} aria-hidden="true"><span>{article.num}</span><div class="art-geometry"></div><span>ANDROMEDA / FIELD GUIDE</span></div><div class="reading-meta"><span>{article.category}</span><span>{article.time}</span></div><h3>{article.title}</h3><p>{article.text}</p><span class="reading-arrow"><Arrow diagonal /></span></a>)}</div></section>
  <section id="explore" class="explore-section" aria-labelledby="explore-title"><div class="container explore-inner"><div><span class="kicker">THERE'S A NEXT CHAPTER IN EVERY BUSINESS.</span><h2 id="explore-title">Make room<br />for <em>yours.</em></h2></div><div class="explore-links"><a href="#workspace"><span><small>FOR THE OPERATORS</small>See the bigger picture</span><Arrow diagonal /></a><a href="/pitch-deck"><span><small>FOR THE FOUNDERS</small>Build a better pitch</span><Arrow diagonal /></a></div></div></section>
</Layout>
