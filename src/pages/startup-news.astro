---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout title="Field Notes — Andromeda" description="Perspectives on building a business, finding clarity, and taking the next step." activePage="news">
  <div class="container notes-page">
    <div class="notes-grid">
      <div class="notes-editorial">
        <h1>A little perspective.</h1>
        <p>Ideas on building a business. Observations from the journey.</p>
        <div class="notes-status">
          <span class="status-cue">Volume 1 in preparation</span>
          <p>Our first field notes are taking shape. In the meantime, there is plenty of actionable structure in the founder's library.</p>
          <a href="/pitch-deck" class="text-link">Explore the pitch library <Arrow diagonal /></a>
        </div>
      </div>
      <div class="notes-cover" data-ui aria-hidden="true">
        <div class="cover-top">
          <span>Andromeda</span>
          <span>Field Notes</span>
        </div>
        <div class="cover-orbits"><i></i><i></i><i></i></div>
        <span class="cover-title">Field notes.</span>
        <div class="cover-bottom">
          <span>Connected business.</span>
        </div>
      </div>
    </div>

    <!-- Archival observatory photographic plates -->
    <section class="notes-gallery" aria-label="Observatory field plates">
      <div class="gallery-lead-card">
        <img 
          src="/images/andromeda-galaxy.jpg" 
          alt="M31 Andromeda galaxy plate" 
          width="1344" 
          height="420" 
          loading="lazy" 
          class="gallery-lead-img"
        />
        <div class="gallery-lead-caption">
          <span>Plate 01 · Archival exposure of M31. Ground truth for connected systems in motion.</span>
        </div>
      </div>
      <div class="gallery-sub-grid">
        <div class="gallery-sub-item">
          <img src="/images/kitt-peak-national-observatory-beneath-star-trails.jpg" alt="Kitt Peak star trails" width="640" height="380" loading="lazy" />
          <span>Observatory telemetry and persistent tracking.</span>
        </div>
        <div class="gallery-sub-item">
          <img src="/images/the-wonderful-universe-explorer-the-great-36.jpg" alt="Lick Observatory 1902 Great Equatorial Telescope" width="640" height="380" loading="lazy" />
          <span>Equatorial instruments and precision alignment.</span>
        </div>
        <div class="gallery-sub-item">
          <img src="/images/1750-star-chart-of-the-constellations-libra.jpg" alt="1750 John Bevis Celestial Atlas" width="640" height="380" loading="lazy" />
          <span>Historical celestial cartography and structural navigation.</span>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const targets = document.querySelectorAll('h1, .notes-editorial > p, .status-cue, .notes-status p, .notes-status a, .notes-cover, .gallery-lead-card, .gallery-sub-item');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    targets.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .notes-page { padding-top: 56px; padding-bottom: 96px; }
  .notes-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: start; margin-bottom: 80px; }
  h1 { font-size: clamp(52px, 6.5vw, 84px); line-height: 1.02; letter-spacing: -0.025em; font-weight: 400; color: var(--fg); }
  h1 + p { font-size: 18px; line-height: 1.6; margin-top: 24px; color: var(--fg-2); }
  .notes-status { padding-top: 24px; margin-top: 48px; max-width: 420px; }
  .status-cue { font-size: 14px; color: var(--accent); display: block; }
  .notes-status p { font-size: 16px; color: var(--fg-2); line-height: 1.65; margin-block: 14px 24px; }
  .notes-cover { background: var(--bg-raised); border-radius: var(--radius); padding: 36px; position: relative; overflow: hidden; aspect-ratio: 0.85; display: flex; flex-direction: column; justify-content: space-between; }
  .cover-top, .cover-bottom { display: flex; justify-content: space-between; font-size: 13px; color: var(--fg-3); z-index: 1; position: relative; }
  .cover-title { font-family: var(--font-display); font-size: 64px; line-height: 1; letter-spacing: -0.03em; color: var(--fg); position: relative; z-index: 1; margin-top: auto; margin-bottom: 32px; }
  .cover-bottom { padding-top: 16px; }
  .cover-orbits { position: absolute; width: 320px; height: 320px; top: 20px; right: -60px; pointer-events: none; }
  .cover-orbits i { position: absolute; inset: 0; border: 1px solid var(--line-strong); border-radius: 50%; /* taste-skill-ignore */ }
  .cover-orbits i:nth-child(2) { inset: 36px; }
  .cover-orbits i:nth-child(3) { inset: 72px; border-color: var(--accent); opacity: 0.5; }

  /* Gallery section */
  .notes-gallery { margin-top: 64px; }
  .gallery-lead-card { background: var(--bg-raised); border-radius: var(--radius); overflow: hidden; margin-bottom: 32px; }
  .gallery-lead-img { width: 100%; height: 380px; object-fit: cover; object-position: center; display: block; filter: contrast(1.05) brightness(0.9); }
  .gallery-lead-caption { padding: 18px 28px; background: #0f1110; font-size: 13px; color: var(--fg-3); }
  .gallery-sub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .gallery-sub-item { display: flex; flex-direction: column; gap: 12px; }
  .gallery-sub-item img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-xs); filter: contrast(1.05) brightness(0.9); }
  .gallery-sub-item span { font-size: 13px; color: var(--fg-3); }

  /* Motion Layer */
  h1, .notes-editorial > p, .status-cue, .notes-status p, .notes-status a, .notes-cover, .gallery-lead-card, .gallery-sub-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(.16, 1, .3, 1), transform 0.6s cubic-bezier(.16, 1, .3, 1);
  }
  h1.in-view, .notes-editorial > p.in-view, .status-cue.in-view, .notes-status p.in-view, .notes-status a.in-view, .notes-cover.in-view, .gallery-lead-card.in-view, .gallery-sub-item.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    h1, .notes-editorial > p, .status-cue, .notes-status p, .notes-status a, .notes-cover, .gallery-lead-card, .gallery-sub-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  @media(max-width: 900px) {
    .notes-grid { grid-template-columns: 1fr; gap: 40px; }
    .gallery-sub-grid { grid-template-columns: 1fr; }
    h1 { font-size: 46px; }
    .notes-cover { max-width: 400px; }
  }
</style>
