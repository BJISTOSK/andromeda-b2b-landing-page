---
import Layout from '../layouts/Layout.astro';

const newsArticles = [
  {
    id: 'aether-cloud-sync',
    category: 'INFRASTRUCTURE',
    categoryClass: 'badge-cyan',
    timestamp: '2 hours ago',
    readTime: '4 min read',
    title: 'Aether Cloud Unveils Zero-Latency Serverless State Synchronization for High-Frequency FinTech',
    excerpt: 'Aether\'s new reactive engine eliminates multi-region database bottlenecks using Convex reactive sync, delivering under 8ms global consistency.',
    author: {
      name: 'Marcus Vance',
      role: 'Infrastructure Architect',
      initials: 'MV',
      color: '#0891b2'
    }
  },
  {
    id: 'vanguard-b2b-funding',
    category: 'FUNDING & VC',
    categoryClass: 'badge-emerald',
    timestamp: '4 hours ago',
    readTime: '3 min read',
    title: 'Vanguard B2B Closes $28M Growth Round to Scale Cross-Border Supplier Escrow',
    excerpt: 'Automating multi-currency liquidity and settlement across 42 countries, Vanguard reports 310% YoY GMV expansion across industrial manufacturing.',
    author: {
      name: 'Sarah Jenkins',
      role: 'Venture Partner',
      initials: 'SJ',
      color: '#059669'
    }
  },
  {
    id: 'synthetic-data-ai',
    category: 'AI & AUTONOMOUS',
    categoryClass: 'badge-purple',
    timestamp: '6 hours ago',
    readTime: '6 min read',
    title: 'Synthetic Data Pipelines Slash Enterprise Model Fine-Tuning Costs by 65%',
    excerpt: 'Benchmark results from 50 enterprise pilots show curated synthetic generation outperforms legacy scraped datasets in accuracy and regulatory compliance.',
    author: {
      name: 'Dr. Aris Thorne',
      role: 'Chief AI Scientist',
      initials: 'AT',
      color: '#7c3aed'
    }
  },
  {
    id: 'decoupled-architectures-report',
    category: 'INDUSTRY REPORT',
    categoryClass: 'badge-blue',
    timestamp: 'Yesterday',
    readTime: '5 min read',
    title: 'Decoupled Web Architectures Surpass Monolithic CMS Across 78% of Fortune 500 Digital Initiatives',
    excerpt: 'Enterprises migrating to static edge front-ends with serverless state report 4x improvement in Core Web Vitals and 90% reduction in cloud compute bills.',
    author: {
      name: 'Elena Rostova',
      role: 'Head of Research',
      initials: 'ER',
      color: '#2563eb'
    }
  },
  {
    id: 'hyperscale-sdk-launch',
    category: 'PRODUCT LAUNCH',
    categoryClass: 'badge-amber',
    timestamp: '2 days ago',
    readTime: '3 min read',
    title: 'HyperScale SDK 3.0 Delivers Instant Edge Multi-Tenancy and RBAC Security Modules',
    excerpt: 'Developers can now instantiate role-based access control, SOC-2 audit logging, and encrypted workspace isolation with three lines of declarative code.',
    author: {
      name: 'Devin Cole',
      role: 'Lead Core Developer',
      initials: 'DC',
      color: '#d97706'
    }
  },
  {
    id: 'yc-founders-gtm',
    category: 'FOUNDER INSIGHTS',
    categoryClass: 'badge-pink',
    timestamp: '3 days ago',
    readTime: '7 min read',
    title: 'How 12 YC Founders Scaled B2B Go-to-Market Pipelines Using Autonomous Agent Routing',
    excerpt: 'First-hand operational takeaways from Y Combinator founders who replaced legacy SDR email sequences with real-time intent-driven AI agents.',
    author: {
      name: 'Kiran Patel',
      role: 'Ecosystem Director',
      initials: 'KP',
      color: '#db2777'
    }
  }
];

const categories = [
  'All Dispatches',
  'Funding & VC',
  'AI & Autonomous',
  'Infrastructure',
  'Product Launches',
  'Founder Insights'
];
---

<Layout 
  title="Startup News & Venture Dispatch | Andromeda"
  description="Real-time startup intelligence, venture funding rounds, AI breakthroughs, and enterprise infrastructure stories across the Andromeda ecosystem."
  activePage="news"
>
  <div class="news-page-wrapper">
    <div class="container">
      
      <!-- News Hero Section -->
      <section class="news-hero">
        <div class="news-hero-badge">
          <span class="live-dot-pulse"></span>
          <span>Andromeda Dispatch &bull; Ecosystem Intel</span>
        </div>

        <h1 class="news-hero-title">
          Startup News &amp; <span class="gradient-text">Venture Dispatch</span>
        </h1>

        <p class="news-hero-desc">
          Real-time intelligence, seed-to-growth venture rounds, autonomous systems breakthroughs, and market movements across the global Andromeda network.
        </p>

        <!-- Live Metrics Bar -->
        <div class="news-metrics-bar">
          <div class="metric-item">
            <span class="metric-value">240+</span>
            <span class="metric-label">Startups Tracked</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-value">$1.8B</span>
            <span class="metric-label">Syndicated Dealflow</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-value">06:00 UTC</span>
            <span class="metric-label">Daily Live Dispatch</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-value">99.9%</span>
            <span class="metric-label">Verified Intel</span>
          </div>
        </div>
      </section>

      <!-- Category Filter Pills -->
      <div class="category-filter-nav">
        <div class="category-scroll-wrap">
          {categories.map((cat, idx) => (
            <button 
              type="button" 
              class:list={['filter-pill', { active: idx === 0 }]}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Featured Story Spotlight -->
      <section class="featured-story-section">
        <article class="featured-card">
          <div class="featured-card-grid">
            <div class="featured-content">
              <div class="featured-meta-row">
                <span class="badge badge-purple">VENTURE BREAKTHROUGH</span>
                <span class="featured-time">15 mins ago &bull; 5 min read</span>
              </div>

              <h2 class="featured-headline">
                <a href="#featured" class="headline-link">
                  Nexus AI Secures $42M Series A to Power Real-Time Agentic Workflows on Cloudflare Edge
                </a>
              </h2>

              <p class="featured-summary">
                Led by Horizon Capital with participation from Andromeda Ventures, Nexus AI enables enterprise teams to deploy autonomous multi-tenant agent fleets with sub-15ms cold start times, declarative schema generation, and end-to-end cryptographic verification.
              </p>

              <div class="featured-footer">
                <div class="author-pill">
                  <div class="author-avatar" style="background-color: #2563eb;">ER</div>
                  <div class="author-details">
                    <span class="author-name">Elena Rostova</span>
                    <span class="author-role">Head of Ecosystem Research</span>
                  </div>
                </div>

                <a href="#featured" class="read-dispatch-btn">
                  <span>Read Full Dispatch</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Spotlight Visual Graphic -->
            <div class="featured-visual">
              <div class="visual-panel">
                <div class="panel-header">
                  <span class="panel-dot red"></span>
                  <span class="panel-dot yellow"></span>
                  <span class="panel-dot green"></span>
                  <span class="panel-title">nexus-ai-round-a.json</span>
                </div>
                <div class="panel-body">
                  <pre><code><span class="c-key">"ventureRound"</span>: <span class="c-str">"Series A"</span>,
<span class="c-key">"amount"</span>: <span class="c-num">$42,000,000</span>,
<span class="c-key">"leadInvestor"</span>: <span class="c-str">"Horizon Capital"</span>,
<span class="c-key">"coInvestors"</span>: [
  <span class="c-str">"Andromeda Ventures"</span>,
  <span class="c-str">"Cloudflare Ventures"</span>
],
<span class="c-key">"networkLatency"</span>: <span class="c-num">"14.2ms"</span>,
<span class="c-key">"status"</span>: <span class="c-bool">"SYNDICATED_ACTIVE"</span></code></pre>
                </div>
                <div class="visual-glow" aria-hidden="true"></div>
              </div>
            </div>
          </div>
        </article>
      </section>

      <!-- News Articles Grid -->
      <section class="news-grid-section">
        <div class="section-heading-row">
          <h3 class="section-title">Latest Dispatches</h3>
          <span class="dispatch-feed-tag">Live Feed Updated Every 15 Min</span>
        </div>

        <div class="news-grid">
          {newsArticles.map((article) => (
            <article class="news-card">
              <div class="card-meta">
                <span class:list={['badge', article.categoryClass]}>{article.category}</span>
                <span class="article-time">{article.timestamp} &bull; {article.readTime}</span>
              </div>

              <h4 class="article-title">
                <a href={`#${article.id}`} class="article-link">
                  {article.title}
                </a>
              </h4>

              <p class="article-excerpt">
                {article.excerpt}
              </p>

              <div class="card-footer">
                <div class="author-pill">
                  <div class="author-avatar" style={`background-color: ${article.author.color};`}>
                    {article.author.initials}
                  </div>
                  <div class="author-details">
                    <span class="author-name">{article.author.name}</span>
                    <span class="author-role">{article.author.role}</span>
                  </div>
                </div>

                <a href={`#${article.id}`} class="card-arrow-link" aria-label={`Read ${article.title}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Newsletter Dispatch Subscription -->
      <section class="newsletter-section">
        <div class="newsletter-card">
          <div class="newsletter-content">
            <div class="newsletter-badge">
              <span class="mail-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </span>
              <span>The Morning Andromeda Signal</span>
            </div>

            <h3 class="newsletter-title">
              Get Curated Ecosystem Intel Directly in Your Inbox
            </h3>

            <p class="newsletter-desc">
              High-signal dispatches delivered every Tuesday &amp; Thursday at 06:00 UTC. Dealflow breakdowns, verified venture rounds, and zero fluff.
            </p>

            <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Andromeda Startup News!');">
              <div class="form-input-wrap">
                <input 
                  type="email" 
                  placeholder="Enter your work email address..." 
                  required 
                  class="newsletter-input" 
                />
                <button type="submit" class="btn btn-primary newsletter-submit-btn">
                  <span>Subscribe to Signal</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>
              <span class="form-disclaimer">Zero spam. Instant 1-click unsubscribe at any time.</span>
            </form>
          </div>
          <div class="newsletter-glow" aria-hidden="true"></div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .news-page-wrapper {
    padding: 2rem 0 6rem;
    position: relative;
    z-index: 2;
  }

  /* News Hero */
  .news-hero {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .news-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background-color: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.2);
    color: var(--brand-blue);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .live-dot-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .news-hero-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .news-hero-desc {
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  /* Live Metrics Bar */
  .news-metrics-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1rem 2rem;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1rem;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .metric-divider {
    width: 1px;
    height: 28px;
    background-color: var(--border-light);
  }

  /* Category Filter Nav */
  .category-filter-nav {
    margin-bottom: 2.5rem;
    display: flex;
    justify-content: center;
  }

  .category-scroll-wrap {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    overflow-x: auto;
    padding: 0.5rem;
    max-width: 100%;
    scrollbar-width: none;
  }

  .category-scroll-wrap::-webkit-scrollbar {
    display: none;
  }

  .filter-pill {
    padding: 0.5rem 1.125rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(226, 232, 240, 0.9);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    color: var(--text-primary);
    border-color: #cbd5e1;
    transform: translateY(-1px);
  }

  .filter-pill.active {
    color: #ffffff;
    background-color: var(--brand-blue);
    border-color: var(--brand-blue);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  /* Featured Story Section */
  .featured-story-section {
    margin-bottom: 4rem;
  }

  .featured-card {
    background: #ffffff;
    border-radius: 1.5rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .featured-card:hover {
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.12);
    border-color: #cbd5e1;
  }

  .featured-card-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
  }

  .featured-content {
    padding: 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .featured-time {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .featured-headline {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .headline-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .headline-link:hover {
    color: var(--brand-blue);
  }

  .featured-summary {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
  }

  .author-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .read-dispatch-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-blue);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .read-dispatch-btn:hover {
    color: var(--brand-blue-hover);
    transform: translateX(3px);
  }

  /* Spotlight Visual Panel */
  .featured-visual {
    background: #090d16;
    height: 100%;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .visual-panel {
    width: 100%;
    max-width: 380px;
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 2;
  }

  .panel-header {
    background: rgba(30, 41, 59, 0.8);
    padding: 0.625rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .panel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .panel-dot.red { background: #ef4444; }
  .panel-dot.yellow { background: #f59e0b; }
  .panel-dot.green { background: #10b981; }

  .panel-title {
    font-family: monospace;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-left: 0.5rem;
  }

  .panel-body {
    padding: 1.25rem 1.5rem;
    font-family: monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: #f8fafc;
  }

  .c-key { color: #38bdf8; }
  .c-str { color: #a7f3d0; }
  .c-num { color: #f472b6; }
  .c-bool { color: #fbbf24; }

  .visual-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.35) 0%, rgba(168, 85, 247, 0.2) 40%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  /* News Grid Section */
  .news-grid-section {
    margin-bottom: 5rem;
  }

  .section-heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .dispatch-feed-tag {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .news-card {
    background: #ffffff;
    border-radius: 1.25rem;
    padding: 2rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px -10px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .article-time {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .article-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .article-link:hover {
    color: var(--brand-blue);
  }

  .article-excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-light);
  }

  .card-arrow-link {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .card-arrow-link:hover {
    background-color: var(--brand-blue);
    color: #ffffff;
    transform: translateX(2px);
  }

  /* Badges */
  .badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-purple {
