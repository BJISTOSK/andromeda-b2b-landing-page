---
---

<div class="pitch-form-container cruip-card">
  <div class="form-header">
    <div class="pill-badge mb-2">
      <span class="pill-highlight">Venture Syndicate</span>
      <span>&bull; Application Portal</span>
    </div>
    <h2 class="form-title">Submit Your <span class="gradient-text">Startup Pitch</span></h2>
    <p class="form-desc">
      Join the Andromeda venture acceleration ecosystem. Your submission is streamed to our reactive Convex dealflow pipeline for enterprise evaluation.
    </p>
  </div>

  <form id="startupPitchForm" class="pitch-form" novalidate>
    <div class="grid-2">
      <div class="form-group">
        <label for="companyName" class="form-label">Startup / Company Name *</label>
        <input 
          type="text" 
          id="companyName" 
          name="companyName" 
          class="form-input" 
          placeholder="e.g. NovaScale AI" 
          required 
        />
        <span class="field-error" id="companyNameError"></span>
      </div>

      <div class="form-group">
        <label for="founderName" class="form-label">Founder / Lead Contact Name *</label>
        <input 
          type="text" 
          id="founderName" 
          name="founderName" 
          class="form-input" 
          placeholder="e.g. Sarah Connor" 
          required 
        />
        <span class="field-error" id="founderNameError"></span>
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label for="email" class="form-label">Work Email *</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-input" 
          placeholder="sarah@novascale.ai" 
          required 
        />
        <span class="field-error" id="emailError"></span>
      </div>

      <div class="form-group">
        <label for="stage" class="form-label">Current Stage *</label>
        <select id="stage" name="stage" class="form-select" required>
          <option value="" disabled selected>Select funding stage</option>
          <option value="Pre-Seed">Pre-Seed ($250k - $750k)</option>
          <option value="Seed">Seed ($1M - $3M)</option>
          <option value="Series A">Series A ($5M - $12M)</option>
          <option value="Enterprise Pilot">Enterprise Pilot (Commercial Partner)</option>
        </select>
        <span class="field-error" id="stageError"></span>
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label for="marketCategory" class="form-label">Market Category *</label>
        <select id="marketCategory" name="marketCategory" class="form-select" required>
          <option value="" disabled selected>Select industry sector</option>
          <option value="Fintech B2B">Fintech & B2B Liquidity</option>
          <option value="AI & Data">AI Infrastructure & LLM Ops</option>
          <option value="Cloud Infrastructure">Cloud & Edge Computing</option>
          <option value="Supply Chain">Supply Chain & Logistics</option>
          <option value="Cybersecurity">Cybersecurity & Zero Trust</option>
        </select>
        <span class="field-error" id="marketCategoryError"></span>
      </div>

      <div class="form-group">
        <label for="fundingAsk" class="form-label">Target Funding Ask ($ USD) *</label>
        <input 
          type="text" 
          id="fundingAsk" 
          name="fundingAsk" 
          class="form-input" 
          placeholder="e.g. $1,500,000" 
          required 
        />
        <span class="field-error" id="fundingAskError"></span>
      </div>
    </div>

    <div class="form-group">
      <label for="deckUrl" class="form-label">Pitch Deck URL / DocSend Link *</label>
      <input 
        type="url" 
        id="deckUrl" 
        name="deckUrl" 
        class="form-input" 
        placeholder="https://docsend.com/view/yourdeck or Google Drive link" 
        required 
      />
      <span class="field-error" id="deckUrlError"></span>
    </div>

    <div class="form-group">
      <label for="pitchSummary" class="form-label">Executive Pitch Summary & Value Proposition *</label>
      <textarea 
        id="pitchSummary" 
        name="pitchSummary" 
        class="form-textarea" 
        placeholder="Describe the problem, your proprietary solution, enterprise traction, and why Andromeda ecosystem accelerates your growth..."
        required
      ></textarea>
      <span class="field-error" id="pitchSummaryError"></span>
    </div>

    <div class="form-footer">
      <div class="convex-sync-status">
        <span class="status-dot status-dot-active"></span>
        <span id="backendStatusLabel">Convex Backend Stream Ready</span>
      </div>

      <button type="submit" id="submitPitchBtn" class="btn btn-primary">
        <span>Transmit Application</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </form>

  <!-- Success Notification Box -->
  <div id="pitchSuccessBox" class="success-box" style="display: none;">
    <div class="success-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>
    <div class="success-content">
      <h3>Pitch Successfully Registered!</h3>
      <p>Your application has been received and routed into the Andromeda Venture Evaluation queue.</p>
      <div class="ref-badge" id="successRefBadge">Application ID: AND-2026-001</div>
    </div>
    <button type="button" id="submitAnotherBtn" class="btn btn-secondary btn-sm">
      Submit Another Pitch
    </button>
  </div>
</div>

<style>
  .pitch-form-container {
    padding: 3rem 2.5rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .form-header {
    margin-bottom: 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .mb-2 {
    margin-bottom: 0.5rem;
  }

  .form-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--text-primary);
  }

  .form-desc {
    color: var(--text-secondary);
    max-width: 620px;
    font-size: 1rem;
    line-height: 1.6;
  }

  .pitch-form {
    display: flex;
    flex-direction: column;
  }

  .field-error {
    font-size: 0.75rem;
    color: #ef4444;
    min-height: 1rem;
    font-weight: 500;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .convex-sync-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .success-box {
    text-align: center;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #ecfdf5;
    border: 1px solid #a7f3d0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-content h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .success-content p {
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto 1.25rem;
  }

  .ref-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    color: var(--brand-blue);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .pitch-form-container {
      padding: 2rem 1.25rem;
    }
    .form-footer {
      flex-direction: column;
      gap: 1.25rem;
      align-items: stretch;
    }
  }
</style>

<script>
  const form = document.getElementById('startupPitchForm') as HTMLFormElement;
  const successBox = document.getElementById('pitchSuccessBox') as HTMLElement;
  const submitBtn = document.getElementById('submitPitchBtn') as HTMLButtonElement;
  const submitAnotherBtn = document.getElementById('submitAnotherBtn') as HTMLButtonElement;
  const refBadge = document.getElementById('successRefBadge') as HTMLElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      let isValid = true;
      const formData = new FormData(form);
      const data: Record<string, string> = {};

      formData.forEach((value, key) => {
        data[key] = value.toString().trim();
      });

      // Simple validation
      ['companyName', 'founderName', 'email', 'stage', 'marketCategory', 'fundingAsk', 'deckUrl', 'pitchSummary'].forEach((field) => {
        const input = document.getElementById(field) as HTMLInputElement;
        const errEl = document.getElementById(`${field}Error`);
        if (!data[field]) {
          isValid = false;
          if (errEl) errEl.textContent = 'This field is required.';
          if (input) input.style.borderColor = '#ef4444';
        } else {
          if (errEl) errEl.textContent = '';
          if (input) input.style.borderColor = '';
        }
      });

      // Validate URL scheme for security (prevent javascript: URIs)
      if (data.deckUrl) {
        try {
          const parsed = new URL(data.deckUrl);
          if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
            isValid = false;
            const errEl = document.getElementById('deckUrlError');
            const input = document.getElementById('deckUrl') as HTMLInputElement;
            if (errEl) errEl.textContent = 'Please enter a valid web URL starting with http:// or https://';
            if (input) input.style.borderColor = '#ef4444';
          }
        } catch {
          isValid = false;
          const errEl = document.getElementById('deckUrlError');
          const input = document.getElementById('deckUrl') as HTMLInputElement;
          if (errEl) errEl.textContent = 'Please enter a valid web URL.';
          if (input) input.style.borderColor = '#ef4444';
        }
      }

      if (!isValid) return;

      // Loading state
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Transmitting to Convex...</span>`;

      try {
        // Simulated network transmission / Convex mutation
        await new Promise((r) => setTimeout(r, 900));

        const generatedId = `AND-${Date.now().toString().slice(-6)}`;
        if (refBadge) refBadge.textContent = `Application ID: ${generatedId}`;

        // Save locally for instant preview
        const stored = JSON.parse(localStorage.getItem('andromeda_pitches') || '[]');
        stored.unshift({ ...data, id: generatedId, createdAt: Date.now() });
        localStorage.setItem('andromeda_pitches', JSON.stringify(stored));

        form.style.display = 'none';
        successBox.style.display = 'flex';
      } catch (err) {
        console.error('Submission failed:', err);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Transmit Application</span>`;
      }
    });
  }

  if (submitAnotherBtn) {
    submitAnotherBtn.addEventListener('click', () => {
      form.reset();
      form.style.display = 'flex';
      successBox.style.display = 'none';
    });
  }
</script>
