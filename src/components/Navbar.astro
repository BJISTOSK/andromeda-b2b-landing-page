---
interface Props {
  activePage?: 'home' | 'pitch' | 'bos' | 'news';
}

const { activePage = 'home' } = Astro.props;
---

<header class="floating-header">
  <div class="floating-header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Andromeda Home">
      <div class="logo-mark">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" fill="url(#logo-grad)" />
          <path d="M16 6L24 20H8L16 6Z" fill="#ffffff" fill-opacity="0.9" />
          <circle cx="16" cy="17" r="3.5" fill="#2563eb" />
          <defs>
            <linearGradient id="logo-grad" x1="0" y1="0" x2="32" y2="32">
              <stop stop-color="#2563eb" />
              <stop offset="1" stop-color="#4f46e5" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <span class="brand-name">Andromeda<span class="brand-dot">.</span></span>
    </a>

    <!-- Nav Links -->
    <nav class="nav-center">
      <a href="/startup-news" class:list={['nav-link-simple', { active: activePage === 'news' }]}>
        Startup News
      </a>
    </nav>

    <!-- Action Buttons -->
    <div class="nav-actions">
      <a href="#signin" class="nav-link-subtle">
        Sign In
      </a>
      <a href="#trial" class="btn btn-primary btn-sm">
        <span>Start Free Trial</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .floating-header {
    position: fixed;
    top: 0.75rem;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0 1rem;
    display: flex;
    justify-content: center;
  }

  .floating-header-inner {
    width: 100%;
    max-width: 1152px;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 0 1.25rem;
    border-radius: 1rem;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.02);
    transition: all 0.2s ease;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .logo-mark {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .brand-dot {
    color: var(--brand-blue);
  }

  .nav-center {
    display: flex;
    align-items: center;
  }

  .nav-link-simple {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link-simple:hover,
  .nav-link-simple.active {
    color: var(--text-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-link-subtle {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link-subtle:hover {
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .nav-link-subtle {
      display: none;
    }
  }
</style>
