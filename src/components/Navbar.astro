---
import BrandMark from './BrandMark.astro';
import Arrow from './Arrow.astro';
interface Props { activePage?: 'home' | 'pitch' | 'bos' | 'news' | 'pitch-deck'; }
const { activePage = 'home' } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Andromeda home"><BrandMark /><span>andromeda<span class="brand-registered">®</span></span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/#workspace">The platform</a>
      <a href="/pitch-deck" aria-current={activePage === 'pitch-deck' ? 'page' : undefined}>Pitch library</a>
      <a href="/startup-news" aria-current={activePage === 'news' ? 'page' : undefined}>Field notes</a>
    </nav>
    <a class="header-action" href="/#explore">Find your next move <Arrow diagonal /></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation"><span></span><span></span></button>
  </div>
  <nav id="mobile-navigation" class="mobile-nav container" aria-label="Mobile navigation" hidden><a href="/#workspace">The platform <Arrow /></a><a href="/pitch-deck">Pitch library <Arrow /></a><a href="/startup-news">Field notes <Arrow /></a><a href="/#explore">Find your next move <Arrow /></a></nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = document.getElementById('mobile-navigation');
  function closeMenu() { if (!toggle || !navigation) return; toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Open navigation'); navigation.hidden = true; }
  toggle?.addEventListener('click', () => {
    if (!navigation) return;
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    navigation.hidden = !open;
  });
  navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  window.matchMedia('(min-width: 761px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
</script>
