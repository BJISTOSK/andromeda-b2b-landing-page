---
import Arrow from '../Arrow.astro';
const views = [
  { 
    id: 'operations', 
    label: 'Operations', 
    title: 'Nothing falls between the cracks.', 
    description: 'Give every moving part an owner, a next step, and a place in the bigger picture.', 
    metric: '8', 
    metricLabel: 'active workflows', 
    secondary: '3', 
    secondaryLabel: 'scheduled for review', 
    columns: ['Workflow', 'Owner', 'Status', 'Next milestone'], 
    rows: [
      ['Partner onboarding', 'Samira A.', 'In progress', 'Contract review'], 
      ['Q4 procurement', 'Daniel K.', 'Needs review', 'Approve suppliers'], 
      ['Customer handover', 'Leila M.', 'On track', 'Team introduction'], 
      ['Monthly reporting', 'Alex R.', 'On track', 'Close & reconcile']
    ] 
  },
  { 
    id: 'commerce', 
    label: 'Commerce', 
    title: 'Keep commercial velocity moving.', 
    description: 'Follow each enterprise partner relationship from qualification to completed delivery.', 
    metric: '12', 
    metricLabel: 'open opportunities', 
    secondary: '4', 
    secondaryLabel: 'ready for follow-up', 
    columns: ['Opportunity', 'Owner', 'Status', 'Next milestone'], 
    rows: [
      ['Atlas distribution', 'Leila M.', 'In progress', 'Send proposal'], 
      ['Northstar renewal', 'Daniel K.', 'Needs review', 'Review terms'], 
      ['Studio partnership', 'Samira A.', 'On track', 'Discovery call'], 
      ['Meridian expansion', 'Alex R.', 'On track', 'Confirm scope']
    ] 
  },
  { 
    id: 'capital', 
    label: 'Capital', 
    title: 'Make your investor story decisive.', 
    description: 'Bring your fundraising syndicate into focus, from narrative synthesis to term sheet execution.', 
    metric: '6', 
    metricLabel: 'investor conversations', 
    secondary: '2', 
    secondaryLabel: 'partner meetings', 
    columns: ['Fundraising milestone', 'Owner', 'Status', 'Next milestone'], 
    rows: [
      ['Seed round narrative', 'Samira A.', 'In progress', 'Refine the story'], 
      ['Investor shortlist', 'Leila M.', 'On track', 'Warm introductions'], 
      ['Financial model', 'Daniel K.', 'Needs review', 'Validate assumptions'], 
      ['Pitch deck structure', 'Alex R.', 'On track', 'Practice the pitch']
    ] 
  },
];
---
<section id="workspace" class="workspace-section" aria-labelledby="workspace-title">
  <div class="container">
    <div class="heading-split">
      <h2 id="workspace-title">The whole picture.</h2>
      <p>Connect your workflows, trading relationships, and strategic capital decisions in one continuous command layer.</p>
    </div>

    <div class="workspace-demo" data-ui>
      <div class="workspace-toolbar">
        <span class="workspace-wordmark">andromeda / workspace</span>
        <span class="sample-label">Interactive Platform Preview</span>
        <span class="workspace-avatar" aria-hidden="true">AC</span>
      </div>
      <div class="workspace-body">
        <div class="workspace-sidebar">
          <div class="workspace-company">Acme Enterprise <span>⌄</span></div>
          <div role="tablist" aria-label="Workspace views" class="tab-container" aria-orientation="vertical">
            {views.map((view, index) => (
              <button 
                id={`tab-${view.id}`} 
                class:list={['workspace-tab', { active: index === 0 }]} 
                role="tab" 
                aria-selected={index === 0} 
                aria-controls={`panel-${view.id}`} 
                tabindex={index === 0 ? 0 : -1} 
                data-view={view.id}
              >
                <span>{view.label}</span>
                <Arrow />
              </button>
            ))}
          </div>
          <div class="sidebar-bottom">
            <span class="sidebar-note">Connected Operations</span>
            <p>Real-time routing across teams and venture syndicates.</p>
          </div>
        </div>
        <div class="workspace-panels">
          {views.map((view, index) => (
            <div id={`panel-${view.id}`} role="tabpanel" aria-labelledby={`tab-${view.id}`} tabindex="0" hidden={index !== 0}>
              <div class="panel-heading">
                <div>
                  <h3>{view.title}</h3>
                  <p>{view.description}</p>
                </div>
              </div>
              <div class="preview-metrics">
                <div class="metric-card">
                  <strong>{view.metric}</strong>
                  <span>{view.metricLabel}</span>
                </div>
                <div class="metric-card">
                  <strong>{view.secondary}</strong>
                  <span>{view.secondaryLabel}</span>
                </div>
                <div class="preview-spark" aria-hidden="true">
                  <svg viewBox="0 0 240 70" fill="none" class="spark-svg">
                    <path d="M0 58 30 52 60 55 90 38 120 42 150 25 180 30 210 12 240 4" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
                  </svg>
                  <span>Flow velocity</span>
                </div>
              </div>
              <div class="preview-table-wrap">
                <table class="preview-table">
                  <caption class="sr-only">{view.label} overview data</caption>
                  <thead>
                    <tr>
                      {view.columns.map(column => <th scope="col">{column}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {view.rows.map(row => (
                      <tr>
                        <th scope="row">{row[0]}</th>
                        <td><span class="person-initial" aria-hidden="true">{row[1].slice(0, 1)}</span>{row[1]}</td>
                        <td><span class:list={['workflow-status', { review: row[2] === 'Needs review' }]}><i></i>{row[2]}</span></td>
                        <td>{row[3]}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="workspace-bottom">
        <span>One workspace. Three connected perspectives.</span>
        <span>Keyboard: Arrow keys switch views</span>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.workspace-tab'));
  const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
  const compact = window.matchMedia('(max-width: 760px)');
  function updateOrientation() { tablist?.setAttribute('aria-orientation', compact.matches ? 'horizontal' : 'vertical'); }
  updateOrientation();
  compact.addEventListener('change', updateOrientation);
  function selectView(tab: HTMLButtonElement, focus = false) {
    tabs.forEach(item => {
      const selected = item === tab;
      item.classList.toggle('active', selected);
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(item.getAttribute('aria-controls') || '');
      if (panel) panel.hidden = !selected;
    });
    if (focus) tab.focus();
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectView(tab));
    tab.addEventListener('keydown', event => {
      let next = index;
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectView(tabs[next], true);
    });
  });
</script>

<style>
  .workspace-section {
    padding: 120px 0;
    background: #0f1110;
  }
  .workspace-demo {
    margin-top: 48px;
    background: var(--bg-raised);
    color: var(--fg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line); /* taste-skill-ignore */
  }
  .workspace-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    border-bottom: 1px solid var(--line); /* taste-skill-ignore */
    background: #141615;
  }
  .workspace-wordmark {
    font-size: 14px;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .sample-label {
    font-size: 13px;
    color: var(--fg-3);
  }
  .workspace-avatar {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: var(--bg-elevated);
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    border-radius: 50%;
  }
  .workspace-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    min-height: 440px;
  }
  .workspace-sidebar {
    border-right: 1px solid var(--line); /* taste-skill-ignore */
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    background: #171a18;
  }
  .workspace-company {
    font-size: 13px;
    font-weight: 500;
    display: flex;
    justify-content: space-between;
    padding: 0 8px 20px;
    color: var(--fg);
    border-bottom: 1px solid var(--line); /* taste-skill-ignore */
  }
  .tab-container {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 16px;
  }
  .workspace-tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--fg-3);
    padding: 12px 10px;
    font-size: 13px;
    text-align: left;
    border-radius: var(--radius-xs);
    transition: background 0.2s, color 0.2s;
  }
  .workspace-tab:hover {
    color: var(--fg);
    background: var(--bg-hover);
  }
  .workspace-tab.active {
    background: var(--bg-elevated);
    color: var(--fg);
    font-weight: 500;
  }
  .workspace-tab :global(svg) {
    width: 12px;
    opacity: 0.6;
  }
  .workspace-tab.active :global(svg) {
    opacity: 1;
    color: var(--accent);
  }
  .sidebar-bottom {
    margin-top: auto;
    padding: 24px 8px 0;
    border-top: 1px solid var(--line); /* taste-skill-ignore */
  }
  .sidebar-note {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 6px;
  }
  .sidebar-bottom p {
    font-size: 13px;
    color: var(--fg-3);
    line-height: 1.5;
  }
  .workspace-panels {
    padding: 36px 40px;
    min-width: 0;
    background: #141615;
  }
  .panel-heading h3 {
    font-size: 26px;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--fg);
  }
  .panel-heading p {
    font-size: 14px;
    color: var(--fg-2);
    max-width: 520px;
  }
  .preview-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: 20px;
    margin-block: 28px;
  }
  .metric-card {
    background: var(--bg-raised);
    padding: 16px 20px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .metric-card strong {
    font-size: 36px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .metric-card span {
    font-size: 13px;
    color: var(--fg-3);
  }
  .preview-spark {
    background: var(--bg-raised);
    padding: 16px 20px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .spark-svg {
    width: 100%;
    height: 38px;
  }
  .preview-spark span {
    font-size: 13px;
    color: var(--fg-3);
    margin-top: 4px;
  }
  .preview-table-wrap {
    overflow-x: auto;
  }
  .preview-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13px;
    white-space: nowrap;
    text-align: left;
  }
  .preview-table th, .preview-table td {
    padding: 12px 14px 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .preview-table thead th {
    font-weight: 500;
    font-size: 13px;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .preview-table tbody th {
    font-weight: 500;
    color: var(--fg);
  }
  .preview-table td {
    color: var(--fg-2);
  }
  .person-initial {
    width: 20px;
    height: 20px;
    display: inline-grid;
    place-items: center;
    background: var(--bg-elevated);
    border-radius: 50%;
    font-size: 13px;
    font-weight: 500;
    margin-right: 8px;
    color: var(--accent);
  }
  .workflow-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--signal);
  }
  .workflow-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
  }
  .workflow-status.review {
    color: var(--accent);
  }
  .workflow-status.review i {
    background: var(--accent);
  }
  .workspace-bottom {
    display: flex;
    justify-content: space-between;
    padding: 14px 28px;
    border-top: 1px solid var(--line); /* taste-skill-ignore */
    color: var(--fg-3);
    font-size: 13px;
    background: #141615;
  }
  @media (max-width: 900px) {
    .workspace-body { grid-template-columns: 1fr; }
    .tab-container { flex-direction: row; flex-wrap: wrap; }
    .workspace-tab { width: auto; }
    .preview-metrics { grid-template-columns: 1fr; }
  }
</style>
