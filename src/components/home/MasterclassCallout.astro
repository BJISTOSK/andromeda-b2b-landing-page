---
const topFrameworks = [
  {
    num: "01",
    name: "Universal 6 Slides",
    source: "Consensus Model",
    time: "10 min",
    slug: "6-slides-core-structure",
    desc: "The universal 6-slide structure duplicated across Sequoia, YC, and 500 Global."
  },
  {
    num: "03",
    name: "Sequoia Capital",
    source: "The Silicon Valley Standard",
    time: "9 min",
    slug: "sequoia-capital-framework",
    desc: "The 10-slide blueprint used by Airbnb to test founder clarity and market scale."
  },
  {
    num: "04",
    name: "Y Combinator",
    source: "Seed Deck Framework",
    time: "8 min",
    slug: "y-combinator-seed-deck",
    desc: "Dead-simple clarity designed for demo day speed, high conversion, and fast diligence."
  },
  {
    num: "10",
    name: "Point Nine Capital",
    source: "SaaS Animal Matrix",
    time: "11 min",
    slug: "point-nine-saas-framework",
    desc: "The legendary SaaS metric table and unit economic architecture for Series A."
  }
];
---

<section class="space-section masterclass-section" aria-labelledby="mc-title">
  <div class="container">
    <div class="mc-card glass spotlight" data-reveal>
      <div class="mc-grid">
        <div class="mc-info">
          <span class="eyebrow">Intelligence &amp; Frameworks</span>
          <h2 id="mc-title" class="mc-title">
            Pitch Deck Masterclass <br />
            <span class="gradient-text">&amp; Venture Blueprints</span>
          </h2>
          <p class="mc-desc">
            Explore 12 exhaustive slide-by-slide blueprints, investor psychology analyses, and deck teardowns synthesized from the world's most successful venture capital firms.
          </p>

          <div class="mc-stats">
            <div class="mc-stat">
              <span class="mc-num">12</span>
              <span class="mc-lbl">VC Blueprints</span>
            </div>
            <div class="mc-stat">
              <span class="mc-num">40+</span>
              <span class="mc-lbl">Slide Frameworks</span>
            </div>
            <div class="mc-stat">
              <span class="mc-num">100%</span>
              <span class="mc-lbl">Open Access</span>
            </div>
          </div>

          <div class="mc-actions">
            <a href="/pitch-deck" class="btn btn-primary btn-lg">
              <span>Explore Masterclass Library</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <div class="mc-cards-stack">
          {topFrameworks.map((fw) => (
            <a href={`/pitch-deck/${fw.slug}`} class="fw-item">
              <div class="fw-left">
                <span class="fw-num">#{fw.num}</span>
                <div class="fw-titles">
                  <h3 class="fw-name">{fw.name}</h3>
                  <span class="fw-src">{fw.source} &middot; {fw.time}</span>
                </div>
              </div>
              <svg class="fw-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .masterclass-section {
    position: relative;
    z-index: 1;
  }

  .mc-card {
    padding: 3.5rem;
    border-radius: 2rem;
    background: linear-gradient(135deg, rgba(19, 23, 38, 0.8) 0%, rgba(9, 10, 15, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 40px rgba(99, 102, 241, 0.15);
  }

  .mc-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .mc-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mc-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .mc-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-300);
  }

  .mc-stats {
    display: flex;
    gap: 2.5rem;
    margin: 0.5rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mc-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mc-num {
    font-family: var(--font-space-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--ink-50);
  }

  .mc-lbl {
    font-size: 0.75rem;
    color: var(--ink-500);
    font-family: var(--font-mono);
  }

  .mc-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .fw-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.35rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .fw-item:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateX(4px);
  }

  .fw-left {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .fw-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-indigo);
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    background: rgba(99, 102, 241, 0.14);
  }

  .fw-titles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .fw-name {
    font-family: var(--font-space-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-50);
  }

  .fw-src {
    font-size: 0.72rem;
    color: var(--ink-500);
  }

  .fw-arrow {
    color: var(--ink-500);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .fw-item:hover .fw-arrow {
    color: var(--c-indigo);
    transform: translateX(3px);
  }

  @media (max-width: 960px) {
    .mc-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .mc-card {
      padding: 2rem;
    }
  }
</style>
