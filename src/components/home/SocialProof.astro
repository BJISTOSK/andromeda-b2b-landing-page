---
const partners = [
  { name: 'Apex Capital', tag: 'Venture Syndicate' },
  { name: 'Vanguard Systems', tag: 'Global Settlement' },
  { name: 'Aether Cloud', tag: 'Edge Compute' },
  { name: 'Krypton Labs', tag: 'Fintech Liquidity' },
  { name: 'Orion Logistics', tag: 'Supply Mesh' },
  { name: 'Hyperion AI', tag: 'Autonomous Ops' }
];

const highlights = [
  { value: '$248M+', label: 'Quarterly Volume', icon: 'volume' },
  { value: '< 9ms', label: 'Global Edge Latency', icon: 'speed' },
  { value: '1,420+', label: 'Active Enterprise Nodes', icon: 'nodes' },
  { value: '99.995%', label: 'Deterministic SLA', icon: 'uptime' }
];
---

<section class="social-proof-section" aria-label="Enterprise Trust & Network Volume">
  <div class="container">
    <!-- Highlights Row -->
    <div class="highlights-grid" data-reveal>
      {highlights.map((h, i) => (
        <div class="highlight-card glass spotlight" style={`--reveal-delay: ${i * 80}ms`}>
          <div class="highlight-inner">
            <span class="highlight-val gradient-text">{h.value}</span>
            <span class="highlight-label">{h.label}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Partner Ribbon -->
    <div class="partner-ribbon-wrap" data-reveal style="--reveal-delay: 200ms">
      <p class="partner-label">TRUSTED BY HIGH-VELOCITY ENTERPRISES &amp; VENTURE SYNDICATES GLOBALLY</p>
      <div class="partner-chips">
        {partners.map((p) => (
          <div class="partner-chip">
            <span class="partner-dot"></span>
            <span class="partner-name">{p.name}</span>
            <span class="partner-tag">{p.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .social-proof-section {
    position: relative;
    z-index: 2;
    padding: 3.5rem 0 4.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .highlight-card {
    padding: 1.5rem 1.75rem;
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .highlight-card:hover {
    transform: translateY(-2px);
    border-color: rgba(167, 139, 250, 0.3);
  }

  .highlight-inner {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .highlight-val {
    font-family: var(--font-space-display);
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .highlight-label {
    font-size: 0.8125rem;
    color: var(--ink-500);
    letter-spacing: 0.02em;
    font-weight: 500;
  }

  .partner-ribbon-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .partner-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-500);
  }

  .partner-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .partner-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: all 0.25s ease;
  }

  .partner-chip:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateY(-1px);
  }

  .partner-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-indigo);
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
  }

  .partner-name {
    font-family: var(--font-space-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-50);
  }

  .partner-tag {
    font-size: 0.72rem;
    color: var(--ink-500);
    font-family: var(--font-mono);
  }

  @media (max-width: 960px) {
    .highlights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }
    .highlight-card {
      padding: 1.25rem;
    }
    .highlight-val {
      font-size: 1.8rem;
    }
  }
</style>
