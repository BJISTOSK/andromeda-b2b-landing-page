---
const stats = [
  { label: 'B2B Volume Settled', value: '$248.6M', delta: '+28.4% YoY', tone: 'indigo' },
  { label: 'Edge CDN Latency', value: '9ms', delta: 'Cloudflare PoPs', tone: 'indigo' },
  { label: 'Enterprise SLA', value: '99.995%', delta: 'SOC-2 Type II', tone: 'indigo' },
  { label: 'Active Node Clusters', value: '1,420+', delta: 'Global Nodes', tone: 'indigo' },
];

const nodes = [
  { id: 'us-east-1a', role: 'Liquidity Hub', tps: '4,820', ms: '9ms', load: 82 },
  { id: 'eu-west-1b', role: 'Settlement Mesh', tps: '3,110', ms: '14ms', load: 64 },
  { id: 'ap-northeast-1c', role: 'Dealflow Engine', tps: '2,640', ms: '18ms', load: 51 },
];

const line = 'M0,160 C40,150 60,118 100,124 C140,130 160,100 200,94 C240,88 262,112 300,102 C340,92 360,62 400,64 C440,66 462,46 500,40 C540,34 570,22 600,14';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Galaxy backdrop -->
  <div class="hero-galaxy" aria-hidden="true">
    <img src="/images/andromeda-galaxy.jpg" alt="" width="1376" height="768" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-orbits" aria-hidden="true">
    <span class="orbit orbit-1"></span>
    <span class="orbit orbit-2"></span>
    <span class="orbit orbit-3"></span>
  </div>

  <div class="container hero-inner">
    <a href="/pitch-deck" class="announce" id="hero-announcement" data-reveal>
      <span class="announce-tag">New</span>
      <span class="announce-text">Pitch Deck Masterclass &middot; 12 VC frameworks</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>

    <h1 id="hero-title" class="hero-title" data-reveal style="--reveal-delay: 80ms">
      The operating system for<br />
      <span class="gradient-text">scaled B2B commerce</span>
    </h1>

    <p class="hero-lead" data-reveal style="--reveal-delay: 160ms">
      Andromeda changes how high-growth enterprises orchestrate liquidity, accelerate venture dealflow, and manage distributed service nodes together.
    </p>

    <div class="hero-ctas" data-reveal style="--reveal-delay: 240ms">
      <a href="#trial" class="btn btn-primary btn-lg" id="hero-cta-trial">
        <span>Start Free Trial</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#features" class="btn btn-secondary btn-lg" id="hero-cta-features">
        <span>Explore the platform</span>
      </a>
    </div>

    <ul class="hero-trust" data-reveal style="--reveal-delay: 320ms">
      <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>SOC-2 Type II</li>
      <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>99.995% uptime SLA</li>
      <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>No credit card required</li>
    </ul>

    <!-- Console mockup -->
    <div class="console-wrap" data-reveal style="--reveal-delay: 420ms">
      <div class="console-halo" aria-hidden="true"></div>

      <div class="float-chip chip-left glass" aria-hidden="true">
        <span class="chip-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5 2 7.5-6.5-4.5L5.5 21l2-7.5L2 9h7z"/></svg>
        </span>
        <span class="chip-copy">
          <strong>Deal closed</strong>
          <small>Series A &middot; $12M syndicated</small>
        </span>
      </div>

      <div class="float-chip chip-right glass" aria-hidden="true">
        <span class="chip-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8M14 7h7v7"/></svg>
        </span>
        <span class="chip-copy">
          <strong>+28.4%</strong>
          <small>Settled volume YoY</small>
        </span>
      </div>

      <div class="console glass" role="img" aria-label="Preview of the Andromeda live operations console">
        <div class="console-bar">
          <div class="console-dots"><span></span><span></span><span></span></div>
          <div class="console-url">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            console.andromedab2b.com/live
          </div>
          <div class="console-status"><span class="live-dot"></span>Convex Sync Active</div>
        </div>

        <div class="console-body">
          <div class="console-stats">
            {stats.map((s) => (
              <div class="c-stat">
                <span class="c-stat-label">{s.label}</span>
                <span class="c-stat-value">{s.value}</span>
                <span class={`c-stat-delta tone-${s.tone}`}>{s.delta}</span>
              </div>
            ))}
          </div>

          <div class="console-panels">
            <div class="c-panel c-chart">
              <div class="c-panel-head">
                <span>Settlement volume</span>
                <span class="c-chip">Last 12 months</span>
              </div>
              <svg class="chart" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#6366f1" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id="chart-stroke" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="45%" stop-color="#818cf8" />
                    <stop offset="100%" stop-color="#6366f1" />
                  </linearGradient>
                </defs>
                <g class="chart-grid">
                  <line x1="0" y1="50" x2="600" y2="50" />
                  <line x1="0" y1="100" x2="600" y2="100" />
                  <line x1="0" y1="150" x2="600" y2="150" />
                </g>
                <path d={`${line} L600,200 L0,200 Z`} fill="url(#chart-fill)" />
                <path class="chart-line" d={line} fill="none" stroke="url(#chart-stroke)" stroke-width="2.5" vector-effect="non-scaling-stroke" pathLength="1" />
              </svg>
              <span class="chart-dot" aria-hidden="true"></span>
            </div>

            <div class="c-panel c-stream">
              <div class="c-panel-head">
                <span>Live node stream</span>
                <span class="c-chip c-chip-live"><span class="live-dot"></span>WS</span>
              </div>
              <ul class="node-list">
                {nodes.map((n) => (
                  <li class="node">
                    <div class="node-top">
                      <span class="node-id">{n.id}</span>
                      <span class="node-ms">{n.ms}</span>
                    </div>
                    <div class="node-meta">{n.role} &middot; {n.tps} tx/s</div>
                    <div class="node-bar"><span style={`width:${n.load}%`}></span></div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    padding: 4.5rem 0 6rem;
    overflow: hidden;
  }

  /* Galaxy + orbits */
  .hero-galaxy {
    position: absolute;
    top: 170px;
    left: 50%;
    width: min(1700px, 160vw);
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 35%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 35%, transparent 72%);
    opacity: 0.85;
  }

  .hero-galaxy img {
    display: block;
    width: 100%;
    height: auto;
    animation: galaxy-breathe 18s ease-in-out infinite alternate;
  }

  @keyframes galaxy-breathe {
    from { transform: scale(1) rotate(0deg); filter: saturate(1.05) brightness(0.9); }
    to { transform: scale(1.06) rotate(-2deg); filter: saturate(1.25) brightness(1.05); }
  }

  .hero-orbits {
    position: absolute;
    top: 470px;
    left: 50%;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 0;
  }

  .orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 1px solid rgba(167, 139, 250, 0.12);
    transform: translate(-50%, -50%) rotateX(72deg);
  }

  .orbit::after {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c4b5fd;
    box-shadow: 0 0 12px 2px rgba(196, 181, 253, 0.8);
  }

  .orbit-1 { width: 760px; height: 760px; animation: spin 40s linear infinite; }
  .orbit-2 { width: 1080px; height: 1080px; border-color: rgba(103, 232, 249, 0.08); animation: spin 70s linear infinite reverse; }
  .orbit-2::after { background: #67e8f9; box-shadow: 0 0 12px 2px rgba(103, 232, 249, 0.7); }
  .orbit-3 { width: 1420px; height: 1420px; border-color: rgba(255, 255, 255, 0.05); animation: spin 110s linear infinite; }
  .orbit-3::after { background: #fcd9a0; box-shadow: 0 0 12px 2px rgba(252, 217, 160, 0.7); }

  @keyframes spin {
    from { transform: translate(-50%, -50%) rotateX(72deg) rotateZ(0deg); }
    to { transform: translate(-50%, -50%) rotateX(72deg) rotateZ(360deg); }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Announcement */
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.3rem 0.9rem 0.3rem 0.3rem;
    margin-bottom: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border-strong);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    color: var(--ink-200);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .announce:hover {
    border-color: rgba(167, 139, 250, 0.5);
    background: rgba(139, 92, 246, 0.1);
  }

  .announce svg { transition: transform 0.25s var(--ease-out-expo); }
  .announce:hover svg { transform: translateX(3px); }

  .announce-tag {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--grad-button);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Headline */
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 980px;
    margin-bottom: 1.6rem;
    background: var(--grad-headline);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 60px rgba(5, 6, 15, 0.6);
  }

  .hero-title .gradient-text {
    display: inline-block;
    padding-bottom: 0.08em;
  }

  .hero-lead {
    max-width: 620px;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.7;
    color: var(--ink-300);
    margin-bottom: 2.4rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .hero-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.6rem;
    font-size: 0.8125rem;
    color: var(--ink-500);
    margin-bottom: 4.5rem;
  }

  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-trust svg { color: var(--c-indigo); }

  /* Console */
  .console-wrap {
    position: relative;
    width: 100%;
    max-width: 1040px;
    perspective: 2000px;
  }

  .console-halo {
    position: absolute;
    inset: -8% 6% 20%;
    background: radial-gradient(ellipse at 50% 30%, rgba(99, 102, 241, 0.4), transparent 70%);
    filter: blur(60px);
    z-index: -1;
  }

  .console {
    border-radius: 1.25rem;
    background: linear-gradient(180deg, rgba(18, 22, 46, 0.82) 0%, rgba(9, 11, 26, 0.92) 100%);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 50px 120px -30px rgba(0, 0, 0, 0.9), var(--glow-soft);
    overflow: hidden;
    text-align: left;
    transform: rotateX(8deg);
    transform-origin: 50% 0%;
    transition: transform 1.2s var(--ease-out-expo);
  }

  .console-wrap:hover .console { transform: rotateX(0deg); }

  .console-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .console-dots { display: flex; gap: 6px; }
  .console-dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.15); }
  .console-dots span:nth-child(3) { background: var(--c-indigo); box-shadow: 0 0 8px rgba(99, 102, 241, 0.6); }

  .console-url {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-500);
  }

  .console-status {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-300);
  }

  .console-body { padding: 1.4rem; display: grid; gap: 1rem; }

  .console-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .c-stat,
  .c-panel {
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .c-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
  }

  .c-stat-label { font-size: 0.72rem; color: var(--ink-500); }

  .c-stat-value {
    font-family: var(--font-space-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink-50);
  }

  .c-stat-delta { font-size: 0.7rem; font-weight: 600; color: var(--c-indigo); }
  .tone-green, .tone-blue, .tone-violet, .tone-indigo { color: var(--c-indigo); }

  .console-panels {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 1rem;
  }

  .c-panel { padding: 1rem 1.1rem 1.1rem; position: relative; }

  .c-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-200);
  }

  .c-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-300);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .c-chip-live .live-dot { width: 5px; height: 5px; }

  .chart { width: 100%; height: 170px; display: block; overflow: visible; }
  .chart-grid line { stroke: rgba(255, 255, 255, 0.05); stroke-dasharray: 4 6; }

  .chart-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 6px rgba(99, 102, 241, 0.8));
  }

  :global(.is-visible) .chart-line { animation: draw 2.4s 0.6s var(--ease-out-expo) forwards; }

  @keyframes draw { to { stroke-dashoffset: 0; } }

  .chart-dot {
    position: absolute;
    right: 1.1rem;
    top: calc(2.9rem + 12px);
    width: 10px;
    height: 10px;
    margin: -5px -5px 0 0;
    border-radius: 50%;
    background: #6366f1;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.25), 0 0 16px rgba(99, 102, 241, 0.9);
    opacity: 0;
  }

  :global(.is-visible) .chart-dot { animation: fade-in 0.6s 2.6s forwards; }
  @keyframes fade-in { to { opacity: 1; } }

  .node-list { list-style: none; display: grid; gap: 0.6rem; }

  .node {
    padding: 0.65rem 0.75rem;
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .node-top { display: flex; justify-content: space-between; align-items: baseline; }
  .node-id { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-50); }
  .node-ms { font-size: 0.7rem; font-weight: 600; color: var(--c-indigo); }
  .node-meta { font-size: 0.7rem; color: var(--ink-500); margin: 0.15rem 0 0.5rem; }

  .node-bar { height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.06); overflow: hidden; }

  .node-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--c-indigo);
    transform-origin: left;
    transform: scaleX(0);
  }

  :global(.is-visible) .node-bar span { animation: grow 1.4s 1s var(--ease-out-expo) forwards; }
  @keyframes grow { to { transform: scaleX(1); } }

  /* Floating chips */
  .float-chip {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border-radius: 1rem;
    background: rgba(18, 22, 46, 0.7);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.8);
    text-align: left;
    animation: float 7s ease-in-out infinite;
  }

  .chip-left { left: -3.5rem; top: 38%; }
  .chip-right { right: -3rem; top: 12%; animation-delay: -3.5s; }

  .chip-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.6rem;
    color: #ffffff;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.35);
  }

  .chip-copy { display: flex; flex-direction: column; line-height: 1.25; }
  .chip-copy strong { font-size: 0.85rem; font-weight: 600; color: var(--ink-50); }
  .chip-copy small { font-size: 0.72rem; color: var(--ink-500); }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (max-width: 1180px) {
    .chip-left { left: -1rem; }
    .chip-right { right: -1rem; }
  }

  @media (max-width: 860px) {
    .console-panels { grid-template-columns: 1fr; }
    .console-stats { grid-template-columns: repeat(2, 1fr); }
    .float-chip { display: none; }
    .console { transform: none; }
    .hero-orbits { display: none; }
  }

  @media (max-width: 560px) {
    .hero { padding-top: 3rem; }
    .console-url { display: none; }
    .console-bar { grid-template-columns: 1fr auto; }
    .console-body { padding: 0.9rem; }
    .c-stat-value { font-size: 1.25rem; }
    .hero-ctas { width: 100%; }
    .hero-ctas .btn { width: 100%; }
  }
</style>
