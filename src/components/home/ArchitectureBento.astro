---
---

<section id="architecture" class="space-section bento-section" aria-labelledby="bento-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Enterprise Core Architecture</span>
      <h2 id="bento-title" class="section-title">
        Engineered for <span class="gradient-text">hyper-scale velocity</span>
      </h2>
      <p class="section-lead">
        Four deeply integrated systems working in unison. From distributed edge nodes to automated venture syndication, Andromeda operates as the central nervous system for modern B2B commerce.
      </p>
    </div>

    <div class="bento-grid">
      <!-- Bento 1: Large Featured Card - Liquidity Settlement Engine -->
      <div class="bento-card bento-card-large glass spotlight" data-reveal style="--reveal-delay: 100ms">
        <div class="bento-content">
          <div class="bento-badge">
            <span class="badge-dot badge-dot-cyan"></span>
            <span>PILLAR 01 &bull; SETTLEMENT MESH</span>
          </div>
          <h3 class="bento-heading">Autonomous Liquidity &amp; Instant B2B Settlement</h3>
          <p class="bento-desc">
            Zero-friction cross-border settlements with multi-tiered netting algorithms. Replaces days-long banking rails with sub-second verified ledger finality.
          </p>
          <div class="bento-stats-row">
            <div class="mini-stat">
              <span class="mini-val text-core">0.42s</span>
              <span class="mini-lbl">Avg Settlement Time</span>
            </div>
            <div class="mini-stat">
              <span class="mini-val gradient-text">100%</span>
              <span class="mini-lbl">Deterministic Netting</span>
            </div>
            <div class="mini-stat">
              <span class="mini-val" style="color: var(--c-indigo);">$0.00</span>
              <span class="mini-lbl">Intermediary Slippage</span>
            </div>
          </div>
        </div>

        <div class="bento-visual visual-settlement">
          <div class="settlement-nodes">
            <div class="mesh-hub">
              <div class="hub-core">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
              </div>
              <span class="hub-label">Andromeda Core</span>
            </div>
            <div class="mesh-satellite sat-1">
              <span class="sat-dot"></span>
              <span>Fedwire Rail</span>
            </div>
            <div class="mesh-satellite sat-2">
              <span class="sat-dot"></span>
              <span>SEPA Instant</span>
            </div>
            <div class="mesh-satellite sat-3">
              <span class="sat-dot"></span>
              <span>USDC Treasury</span>
            </div>
            <div class="mesh-satellite sat-4">
              <span class="sat-dot"></span>
              <span>SWIFT gpi</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bento 2: Medium Card - Autonomous BOS Orchestration -->
      <div class="bento-card bento-card-medium glass spotlight" data-reveal style="--reveal-delay: 200ms">
        <div class="bento-content">
          <div class="bento-badge">
            <span class="badge-dot badge-dot-violet"></span>
            <span>PILLAR 02 &bull; TELEMETRY</span>
          </div>
          <h3 class="bento-heading">Autonomous BOS &amp; Reactive Pipeline Engine</h3>
          <p class="bento-desc">
            Direct real-time reactive sync with self-healing node clusters and automated incident mitigation.
          </p>
        </div>

        <div class="bento-visual visual-bos">
          <div class="terminal-mock">
            <div class="term-line"><span class="term-prompt">&gt;</span> node-cluster::verify_quorum()</div>
            <div class="term-line text-green"><span class="term-status">&#10003;</span> 1,420 nodes synchronized [9ms]</div>
            <div class="term-line"><span class="term-prompt">&gt;</span> convex_stream::backpressure_check()</div>
            <div class="term-line text-blue"><span class="term-status">&#9679;</span> Zero queue delay &middot; 4,820 tx/s</div>
            <div class="term-line term-active"><span class="term-prompt">&gt;</span> orchestrator::health_matrix <span class="term-cursor"></span></div>
          </div>
        </div>
      </div>

      <!-- Bento 3: Medium Card - Global Edge Mesh -->
      <div class="bento-card bento-card-medium glass spotlight" data-reveal style="--reveal-delay: 300ms">
        <div class="bento-content">
          <div class="bento-badge">
            <span class="badge-dot badge-dot-blue"></span>
            <span>PILLAR 03 &bull; GLOBAL EDGE</span>
          </div>
          <h3 class="bento-heading">Sub-10ms Distributed Service Nodes</h3>
          <p class="bento-desc">
            Static decoupled speed at Cloudflare PoPs worldwide. Zero server cold starts, full SSR caching, and instant failover routing.
          </p>
        </div>

        <div class="bento-visual visual-globe">
          <div class="globe-ping-wrap">
            <div class="ping-circle circle-1"></div>
            <div class="ping-circle circle-2"></div>
            <div class="ping-circle circle-3"></div>
            <div class="center-core">
              <span class="live-dot"></span>
              <span class="core-text">Edge Active</span>
            </div>
          </div>
          <div class="globe-cities">
            <span class="city-tag">SFO: 6ms</span>
            <span class="city-tag">FRA: 11ms</span>
            <span class="city-tag">TYO: 14ms</span>
            <span class="city-tag">SIN: 12ms</span>
          </div>
        </div>
      </div>

      <!-- Bento 4: Large Featured Card - Venture Dealflow & Syndication -->
      <div class="bento-card bento-card-large glass spotlight" data-reveal style="--reveal-delay: 400ms">
        <div class="bento-content">
          <div class="bento-badge">
            <span class="badge-dot badge-dot-pink"></span>
            <span>PILLAR 04 &bull; VENTURE SYNDICATION</span>
          </div>
          <h3 class="bento-heading">Accelerated Venture Dealflow &amp; Capital Syndication</h3>
          <p class="bento-desc">
            Direct portal connecting vetted high-growth B2B founders with elite tier-1 funds. Structured frameworks synthesized from Sequoia, Y Combinator, and Point Nine.
          </p>
          <div class="dealflow-tags">
            <span class="df-tag">Automated Pitch Evaluation</span>
            <span class="df-tag">Cap Table Synchronization</span>
            <span class="df-tag">LP Allocation Mesh</span>
            <span class="df-tag">12 VC Blueprints Included</span>
          </div>
        </div>

        <div class="bento-visual visual-dealflow">
          <div class="deal-card-stack">
            <div class="deal-card dc-1">
              <div class="dc-head">
                <span class="dc-name">NovaScale AI</span>
                <span class="dc-badge">Series A &middot; $12M</span>
              </div>
              <div class="dc-bar"><span style="width: 85%;"></span></div>
              <div class="dc-foot">Lead: Sequoia Capital &middot; 85% Allocated</div>
            </div>
            <div class="deal-card dc-2">
              <div class="dc-head">
                <span class="dc-name">Krypton Pay</span>
                <span class="dc-badge">Seed &middot; $3.5M</span>
              </div>
              <div class="dc-bar"><span style="width: 100%;"></span></div>
              <div class="dc-foot">Closed &middot; Fully Syndicated</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-section {
    position: relative;
    z-index: 1;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
  }

  .bento-card {
    border-radius: 1.5rem;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 380px;
    background: rgba(18, 22, 46, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: rgba(167, 139, 250, 0.3);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 30px rgba(124, 58, 237, 0.12);
  }

  .bento-card-large {
    grid-column: span 7;
  }

  .bento-card-medium {
    grid-column: span 5;
  }

  .bento-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-300);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-indigo);
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.7);
  }

  .badge-dot-cyan,
  .badge-dot-violet,
  .badge-dot-blue,
  .badge-dot-pink {
    background: var(--c-indigo);
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.7);
  }

  .bento-heading {
    font-family: var(--font-space-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--ink-50);
    margin-bottom: 0.85rem;
  }

  .bento-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-300);
    margin-bottom: 1.75rem;
  }

  .bento-stats-row {
    display: flex;
    gap: 2rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mini-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mini-val {
    font-family: var(--font-space-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .mini-lbl {
    font-size: 0.72rem;
    color: var(--ink-500);
  }

  /* Visual: Settlement mesh */
  .visual-settlement {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 1rem;
    background: rgba(9, 11, 26, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .settlement-nodes {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .mesh-hub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hub-core {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--c-indigo);
    display: grid;
    place-items: center;
    color: #fff;
    box-shadow: 0 0 25px rgba(99, 102, 241, 0.7);
  }

  .hub-label {
    font-family: var(--font-space-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-50);
  }

  .mesh-satellite {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-200);
  }

  .sat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-indigo);
  }

  /* Visual: Terminal */
  .visual-bos {
    margin-top: 1rem;
  }

  .terminal-mock {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 1.25rem;
    border-radius: 0.85rem;
    background: rgba(9, 11, 26, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .term-line { color: var(--ink-300); }
  .term-prompt { color: var(--c-indigo); font-weight: 600; margin-right: 0.35rem; }
  .text-green { color: var(--c-indigo); }
  .text-blue { color: var(--c-indigo); }
  .term-status { margin-right: 0.35rem; font-weight: 600; }
  .term-active { color: var(--ink-50); font-weight: 500; }
  .term-cursor {
    display: inline-block;
    width: 7px;
    height: 12px;
    background: var(--c-indigo);
    margin-left: 4px;
    animation: term-blink 1s infinite;
  }

  @keyframes term-blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }

  /* Visual: Globe */
  .visual-globe {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .globe-ping-wrap {
    position: relative;
    width: 140px;
    height: 140px;
    display: grid;
    place-items: center;
  }

  .ping-circle {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(99, 102, 241, 0.35);
    animation: ping-pulse 3s cubic-bezier(0, 0.2, 0.8, 1) infinite;
  }

  .circle-2 { animation-delay: -1s; }
  .circle-3 { animation-delay: -2s; }

  @keyframes ping-pulse {
    0% { transform: scale(0.3); opacity: 0.9; }
    100% { transform: scale(1.1); opacity: 0; }
  }

  .center-core {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgba(9, 11, 26, 0.9);
    border: 1px solid rgba(99, 102, 241, 0.45);
    z-index: 2;
  }

  .core-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-50);
  }

  .globe-cities {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .city-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--ink-300);
  }

  /* Visual: Dealflow */
  .visual-dealflow {
    margin-top: 1.5rem;
  }

  .deal-card-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .deal-card {
    padding: 1rem 1.25rem;
    border-radius: 0.85rem;
    background: rgba(9, 11, 26, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dc-name {
    font-family: var(--font-space-display);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink-50);
  }

  .dc-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--c-indigo);
  }

  .dc-bar {
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .dc-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--c-indigo);
  }

  .dc-foot {
    font-size: 0.72rem;
    color: var(--ink-500);
  }

  .dealflow-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .df-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    color: #ffffff;
  }

  @media (max-width: 960px) {
    .bento-card-large,
    .bento-card-medium {
      grid-column: span 12;
    }
  }

  @media (max-width: 640px) {
    .bento-stats-row {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
