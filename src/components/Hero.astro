---
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Announcement / Avatar Trust Pill -->
    <div class="hero-trust-bar">
      <div class="avatar-stack">
        <div class="avatar-circle av-1">AO</div>
        <div class="avatar-circle av-2">MK</div>
        <div class="avatar-circle av-3">SL</div>
        <div class="avatar-circle av-4">DR</div>
        <div class="avatar-circle av-5">+1.4k</div>
      </div>
      <a href="/startups-pitch" class="trust-text">
        <span>Trusted by 1,400+ Enterprise Leaders & Founders</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Main Headline -->
    <h1 class="hero-title">
      The modern operating system <br class="hidden sm:inline" />
      for <span class="gradient-text">scaled B2B commerce</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle">
      Andromeda changes how high-growth enterprises orchestrate liquidity, accelerate venture dealflow, and manage distributed service nodes together.
    </p>

    <!-- Dual CTAs -->
    <div class="hero-cta-group">
      <a href="/bos" class="btn btn-primary btn-hero">
        <span>Enter BOS Console</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="/startups-pitch" class="btn btn-secondary btn-hero">
        <span>Startups Pitch Track</span>
      </a>
    </div>

    <!-- Hero Mockup Showcase (Cruip Signature Preview Frame) -->
    <div class="hero-mockup-wrap">
      <div class="hero-mockup cruip-card">
        <!-- Browser Top Bar -->
        <div class="mockup-header">
          <div class="mockup-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="mockup-address-bar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>https://console.andromedab2b.com/live</span>
          </div>
          <div class="mockup-status">
            <span class="status-dot status-dot-active"></span>
            <span>Convex Sync Active</span>
          </div>
        </div>

        <!-- Mockup Content Body -->
        <div class="mockup-body">
          <!-- Top Telemetry Row -->
          <div class="telemetry-grid">
            <div class="telemetry-stat">
              <span class="stat-label">B2B Volume Settled</span>
              <span class="stat-value">$248.6M</span>
              <span class="stat-pill text-emerald">+28.4% YoY</span>
            </div>
            <div class="telemetry-stat">
              <span class="stat-label">Edge CDN Latency</span>
              <span class="stat-value">9ms</span>
              <span class="stat-pill text-blue">Cloudflare PoPs</span>
            </div>
            <div class="telemetry-stat">
              <span class="stat-label">Enterprise SLA</span>
              <span class="stat-value">99.995%</span>
              <span class="stat-pill text-indigo">SOC-2 Type II</span>
            </div>
            <div class="telemetry-stat">
              <span class="stat-label">Active Node Clusters</span>
              <span class="stat-value">1,420+</span>
              <span class="stat-pill text-emerald">Global Nodes</span>
            </div>
          </div>

          <!-- Interactive Node Ticker Preview -->
          <div class="preview-activity">
            <div class="activity-header">
              <span class="activity-title">Live Node Cluster Stream</span>
              <span class="activity-badge">Real-Time WebSocket Feed</span>
            </div>
            <div class="activity-items">
              <div class="activity-item">
                <span class="node-id">us-east-1a (Liquidity Hub)</span>
                <span class="node-metric">Throughput: 4,820 tx/s</span>
                <span class="node-status text-emerald">Healthy &bull; 9ms</span>
              </div>
              <div class="activity-item">
                <span class="node-id">eu-west-1b (Settlement Mesh)</span>
                <span class="node-metric">Throughput: 3,110 tx/s</span>
                <span class="node-status text-emerald">Healthy &bull; 14ms</span>
              </div>
              <div class="activity-item">
                <span class="node-id">ap-northeast-1c (Dealflow Engine)</span>
                <span class="node-metric">Throughput: 2,640 tx/s</span>
                <span class="node-status text-emerald">Healthy &bull; 18ms</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Subtle background glow under card -->
      <div class="mockup-glow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 3rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Trust Bar with Avatars */
  .hero-trust-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 1rem 0.35rem 0.5rem;
    border-radius: 9999px;
    background-color: #ffffff;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-xs);
    margin-bottom: 2rem;
    transition: all 0.2s ease;
  }

  .hero-trust-bar:hover {
    border-color: var(--brand-blue);
    box-shadow: var(--shadow-sm);
  }

  .avatar-stack {
    display: flex;
    align-items: center;
    margin-right: -0.25rem;
  }

  .avatar-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    font-size: 0.625rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: -0.5rem;
    color: #ffffff;
  }

  .avatar-circle:first-child {
    margin-left: 0;
  }

  .av-1 { background-color: #2563eb; }
  .av-2 { background-color: #4f46e5; }
  .av-3 { background-color: #06b6d4; }
  .av-4 { background-color: #ec4899; }
  .av-5 { background-color: #64748b; font-size: 0.55rem; }

  .trust-text {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: color 0.15s ease;
  }

  .trust-text:hover {
    color: var(--brand-blue);
  }

  /* Hero Typography */
  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.035em;
    max-width: 900px;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  /* CTAs */
  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .btn-hero {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    border-radius: 0.5rem;
  }

  /* Mockup Frame */
  .hero-mockup-wrap {
    width: 100%;
    max-width: 980px;
    position: relative;
  }

  .hero-mockup {
    width: 100%;
    background-color: #ffffff;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-2xl);
    border: 1px solid rgba(226, 232, 240, 0.9);
    position: relative;
    z-index: 2;
  }

  .mockup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background-color: #f8fafc;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mockup-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background-color: #ef4444; }
  .dot-yellow { background-color: #f59e0b; }
  .dot-green { background-color: #10b981; }

  .mockup-address-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 0.375rem;
    padding: 0.25rem 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: monospace;
    width: 100%;
    max-width: 380px;
    justify-content: center;
  }

  .mockup-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Mockup Body */
  .mockup-body {
    padding: 2rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .telemetry-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-xs);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .stat-pill {
    font-size: 0.7rem;
    font-weight: 600;
  }

  .text-emerald { color: #059669; }
  .text-blue { color: #2563eb; }
  .text-indigo { color: #4f46e5; }

  /* Activity Stream */
  .preview-activity {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.25rem;
    box-shadow: var(--shadow-xs);
    text-align: left;
  }

  .activity-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .activity-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .activity-badge {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--brand-blue);
    background-color: var(--brand-blue-light);
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
  }

  .activity-items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .activity-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background-color: #f8fafc;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
  }

  .node-id {
    font-weight: 600;
    color: var(--text-primary);
  }

  .node-metric {
    color: var(--text-secondary);
  }

  .node-status {
    font-weight: 600;
    font-size: 0.75rem;
  }

  /* Mockup Glow */
  .mockup-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -40%);
    width: 80%;
    height: 80%;
    background: radial-gradient(ellipse, rgba(37, 99, 235, 0.15) 0%, rgba(99, 102, 241, 0.08) 50%, transparent 70%);
    filter: blur(40px);
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .telemetry-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .hero-cta-group .btn {
      width: 100%;
    }
    .activity-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    .telemetry-grid {
      grid-template-columns: 1fr;
    }
    .mockup-address-bar {
      display: none;
    }
  }
</style>
