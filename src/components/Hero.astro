---
---

<section class="hero-section">
  <div class="container hero-content">
    <div class="hero-badge-wrap">
      <div class="badge badge-cyan">
        <span class="status-dot status-dot-active"></span>
        Andromeda 2.0 &bull; Cloudflare CDN &bull; Convex Reactive
      </div>
    </div>

    <h1 class="hero-title">
      The Autonomous <br />
      <span class="gradient-text">B2B Operating Fabric</span>
    </h1>

    <p class="hero-subtitle">
      Accelerate enterprise commerce, liquidity orchestration, and high-velocity venture dealflow with a strictly decoupled static front-end and a real-time reactive backend.
    </p>

    <div class="hero-cta-group">
      <a href="/bos" class="btn btn-primary btn-glow">
        <span>Enter BOS Console</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="/startups-pitch" class="btn btn-secondary">
        <span>Startups Pitch Deck</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </a>
    </div>

    <!-- Live Telemetry Ticker -->
    <div class="telemetry-bar glass-card">
      <div class="telemetry-item">
        <div class="telemetry-label">B2B Volume</div>
        <div class="telemetry-value">$248.6M+</div>
        <div class="telemetry-change text-emerald">&uarr; +28.4% YoY</div>
      </div>
      <div class="telemetry-divider"></div>
      <div class="telemetry-item">
        <div class="telemetry-label">Edge Latency</div>
        <div class="telemetry-value">9ms</div>
        <div class="telemetry-change text-cyan">Cloudflare PoPs</div>
      </div>
      <div class="telemetry-divider"></div>
      <div class="telemetry-item">
        <div class="telemetry-label">Enterprise SLA</div>
        <div class="telemetry-value">99.995%</div>
        <div class="telemetry-change text-violet">SOC-2 Type II</div>
      </div>
      <div class="telemetry-divider"></div>
      <div class="telemetry-item">
        <div class="telemetry-label">Active Partners</div>
        <div class="telemetry-value">1,420+</div>
        <div class="telemetry-change text-emerald">Global Nodes</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-wrap {
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    max-width: 900px;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: #94a3b8;
    max-width: 720px;
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  /* Telemetry Bar */
  .telemetry-bar {
    width: 100%;
    max-width: 960px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 1.5rem 2rem;
    background: rgba(11, 17, 32, 0.75);
    border: 1px solid var(--border-bright);
    box-shadow: var(--shadow-md);
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .telemetry-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .telemetry-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
  }

  .telemetry-change {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .text-emerald { color: var(--accent-emerald); }
  .text-cyan { color: var(--accent-cyan); }
  .text-violet { color: var(--accent-violet); }

  .telemetry-divider {
    width: 1px;
    height: 40px;
    background: var(--border-subtle);
  }

  @media (max-width: 768px) {
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .hero-cta-group .btn {
      width: 100%;
    }
    .telemetry-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .telemetry-divider {
      display: none;
    }
  }
</style>
