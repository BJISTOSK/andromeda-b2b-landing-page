---
---

<!-- Section 1: Business Categories / Core Solutions -->
<section id="solutions" class="categories-section">
  <div class="container">
    <div class="section-intro">
      <div class="pill-badge">
        <span class="pill-highlight">Core Pillars</span>
        <span>&bull; Enterprise B2B Solutions</span>
      </div>
      <h2 class="section-title">
        Engineered for high-velocity <br />
        <span class="gradient-text">enterprise commerce</span>
      </h2>
      <p class="section-desc">
        A unified architecture bridging modern static front-end delivery with real-time reactive infrastructure.
      </p>
    </div>

    <!-- Category Cards -->
    <div class="grid-3 category-cards">
      <!-- Pillar 1: BOS -->
      <div class="cruip-card category-card">
        <div class="category-icon icon-blue">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3 class="category-name">BOS Business Operating System</h3>
        <p class="category-desc">
          Unified operational console with live cluster throughput, automated node synchronization, and dispatchable multi-service pipelines.
        </p>
        <a href="/bos" class="category-link">
          <span>Explore BOS Console</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <!-- Pillar 2: Startups Pitch -->
      <div class="cruip-card category-card">
        <div class="category-icon icon-indigo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <h3 class="category-name">Startups Pitch Engine</h3>
        <p class="category-desc">
          High-velocity dealflow track. Vetted startup founders submit structured pitch applications directly into the enterprise syndicate pipeline.
        </p>
        <a href="/startups-pitch" class="category-link">
          <span>Submit Pitch Deck</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <!-- Pillar 3: Decoupled Architecture -->
      <div class="cruip-card category-card">
        <div class="category-icon icon-cyan">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <h3 class="category-name">Decoupled Front-End Architecture</h3>
        <p class="category-desc">
          Pure static HTML/CSS delivery with zero client hydration overhead on static pages, achieving 100/100 Core Web Vitals and lightning TTFB.
        </p>
        <a href="/#architecture" class="category-link">
          <span>View Decoupled Specs</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Section 2: Features Planet (Cruip's Signature Dark Section) -->
<section class="dark-section features-planet-section">
  <div class="container">
    <div class="planet-header">
      <h2 class="planet-title">
        Andromeda helps your teams work more efficiently together
      </h2>
      <p class="planet-subtitle">
        Deploy globally on Cloudflare edge locations while streaming stateful changes through Convex reactive cloud.
      </p>
    </div>

    <!-- Planet Graphic Showcase -->
    <div class="planet-graphic-wrap">
      <div class="planet-sphere">
        <div class="planet-core"></div>
        <div class="planet-ring"></div>
        
        <!-- Orbiting Badges -->
        <div class="orbit-badge badge-top-left">
          <span class="status-dot status-dot-active"></span>
          <span>Andromeda BOS 2.0</span>
        </div>
        <div class="orbit-badge badge-top-right">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
          </svg>
          <span>Cloudflare 300+ PoPs</span>
        </div>
        <div class="orbit-badge badge-bottom-left">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
          <span>Convex Reactive</span>
        </div>
        <div class="orbit-badge badge-bottom-right">
          <span class="status-dot status-dot-active"></span>
          <span>SOC-2 Type II</span>
        </div>
      </div>
    </div>

    <!-- 6-Card Planet Feature Grid (Cruip Style) -->
    <div class="grid-3 planet-grid">
      <!-- Card 1 -->
      <div class="dark-card">
        <div class="dark-icon icon-blue">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 20V10"></path>
            <path d="M12 20V4"></path>
            <path d="M6 20v-6"></path>
          </svg>
        </div>
        <h4 class="dark-card-title">Instant Analytics</h4>
        <p class="dark-card-desc">
          Collect essential insights about how service nodes and transaction clusters are performing with in-depth throughput metrics.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="dark-card">
        <div class="dark-icon icon-cyan">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <h4 class="dark-card-title">Decoupled Static Front</h4>
        <p class="dark-card-desc">
          Pre-rendered static HTML/CSS generated via Astro 7.x, guaranteeing zero unnecessary runtime JS overhead and maximum SEO.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="dark-card">
        <div class="dark-icon icon-indigo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <h4 class="dark-card-title">Convex Reactive Backend</h4>
        <p class="dark-card-desc">
          ACID-compliant serverless database providing real-time WebSocket subscriptions, instant mutations, and strict schemas.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="dark-card">
        <div class="dark-icon icon-emerald">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
          </svg>
        </div>
        <h4 class="dark-card-title">Cloudflare Edge CDN</h4>
        <p class="dark-card-desc">
          Worldwide edge distribution across 300+ cities with enterprise DDoS protection, automatic SSL, and sub-10ms latency.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="dark-card">
        <div class="dark-icon icon-pink">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <h4 class="dark-card-title">Dealflow Syndication</h4>
        <p class="dark-card-desc">
          Dedicated venture pipeline connecting verified startup pitch decks with enterprise corporate venture capital partners.
        </p>
      </div>

      <!-- Card 6 -->
      <div class="dark-card">
        <div class="dark-icon icon-amber">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h4 class="dark-card-title">Enterprise Security Mesh</h4>
        <p class="dark-card-desc">
          End-to-end cryptographic audit trails, granular role-based permissions, and strict Content Security Policies.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Categories Section */
  .categories-section {
    padding: 5rem 0;
    background-color: var(--bg-page);
  }

  .section-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 1.25rem 0 1rem;
    color: var(--text-primary);
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .category-cards {
    margin-bottom: 2rem;
  }

  .category-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .category-icon {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .icon-blue {
    background-color: #eff6ff;
    color: #2563eb;
    border: 1px solid #dbeafe;
  }

  .icon-indigo {
    background-color: #eef2ff;
    color: #4f46e5;
    border: 1px solid #e0e7ff;
  }

  .icon-cyan {
    background-color: #ecfeff;
    color: #0891b2;
    border: 1px solid #cffafe;
  }

  .icon-emerald {
    background-color: #ecfdf5;
    color: #059669;
    border: 1px solid #d1fae5;
  }

  .icon-pink {
    background-color: #fdf2f8;
    color: #db2777;
    border: 1px solid #fce7f3;
  }

  .icon-amber {
    background-color: #fffbeb;
    color: #d97706;
    border: 1px solid #fef3c7;
  }

  .category-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .category-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--brand-blue);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .category-link:hover {
    color: var(--brand-blue-hover);
    transform: translateX(2px);
  }

  /* Planet Section (Cruip Dark Contrast) */
  .features-planet-section {
    position: relative;
    padding: 7rem 0 6rem;
  }

  .planet-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 4rem;
  }

  .planet-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .planet-subtitle {
    color: #94a3b8;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  /* Planet Sphere */
  .planet-graphic-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 5rem;
    position: relative;
  }

  .planet-sphere {
    position: relative;
    width: 280px;
    height: 280px;
  }

  .planet-core {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--grad-planet);
    box-shadow: 
      inset -20px -20px 50px rgba(0, 0, 0, 0.8),
      inset 20px 20px 50px rgba(56, 189, 248, 0.4),
      0 0 80px rgba(37, 99, 235, 0.4);
    animation: planet-pulse 6s ease-in-out infinite alternate;
  }

  @keyframes planet-pulse {
    0% { transform: scale(0.98); box-shadow: 0 0 60px rgba(37, 99, 235, 0.3); }
    100% { transform: scale(1.02); box-shadow: 0 0 90px rgba(56, 189, 248, 0.5); }
  }

  /* Orbiting Badges */
  .orbit-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #f1f5f9;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    animation: float 4s ease-in-out infinite alternate;
  }

  .badge-top-left {
    top: 10%;
    left: -40%;
    animation-delay: 0s;
  }

  .badge-top-right {
    top: 15%;
    right: -45%;
    animation-delay: 1s;
  }

  .badge-bottom-left {
    bottom: 15%;
    left: -35%;
    animation-delay: 2s;
  }

  .badge-bottom-right {
    bottom: 10%;
    right: -40%;
    animation-delay: 3s;
  }

  @keyframes float {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-8px); }
  }

  /* Planet Grid Cards */
  .planet-grid {
    margin-top: 1rem;
  }

  .dark-icon {
    width: 40px;
    height: 40px;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .dark-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .dark-card-desc {
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .orbit-badge {
      position: static;
      margin: 0.25rem;
    }
    .planet-sphere {
      width: 200px;
      height: 200px;
    }
    .badge-top-left, .badge-top-right, .badge-bottom-left, .badge-bottom-right {
      position: static;
    }
    .planet-graphic-wrap {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
  }
</style>
