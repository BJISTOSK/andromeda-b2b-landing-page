---
---

<section id="solutions" class="features-section">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-violet">Ecosystem Architecture</div>
      <h2 class="section-title">
        Engineered for <span class="gradient-text">Infinite Enterprise Scale</span>
      </h2>
      <p class="section-desc">
        A completely modular foundation. The presentation layer is decoupled for sub-second edge loads, while the Convex backend guarantees sub-millisecond reactive consistency.
      </p>
    </div>

    <div class="grid-3">
      <!-- Card 1: BOS -->
      <div class="glass-card feature-card">
        <div class="feature-icon icon-cyan">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3 class="feature-title">BOS Business Operating System</h3>
        <p class="feature-text">
          Enterprise operational dashboard with live system telemetry, automated node synchronization, and dispatchable multi-service pipelines.
        </p>
        <a href="/bos" class="feature-link">
          Explore BOS Console &rarr;
        </a>
      </div>

      <!-- Card 2: Startups Pitch -->
      <div class="glass-card feature-card">
        <div class="feature-icon icon-pink">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <h3 class="feature-title">Startups Pitch Engine</h3>
        <p class="feature-text">
          Direct dealflow acceleration track. Startups submit structured pitch decks directly into the reactive Convex pipeline for enterprise pilot matching.
        </p>
        <a href="/startups-pitch" class="feature-link">
          Submit Pitch Application &rarr;
        </a>
      </div>

      <!-- Card 3: Decoupled Architecture -->
      <div class="glass-card feature-card">
        <div class="feature-icon icon-indigo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <h3 class="feature-title">Decoupled Static Front-End</h3>
        <p class="feature-text">
          Built with Astro for pure HTML/CSS delivery with zero client hydration overhead on static pages, drastically boosting SEO and Core Web Vitals.
        </p>
        <span class="feature-tag">100/100 Lighthouse</span>
      </div>

      <!-- Card 4: Cloudflare CDN -->
      <div class="glass-card feature-card">
        <div class="feature-icon icon-emerald">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
          </svg>
        </div>
        <h3 class="feature-title">Cloudflare Edge CDN</h3>
        <p class="feature-text">
          Global edge caching across 300+ cities worldwide with enterprise DDoS mitigation, HTTP/3, and automatic CI/CD deployment via GitHub Actions.
        </p>
        <span class="feature-tag">300+ Edge PoPs</span>
      </div>

      <!-- Card 5: Convex Reactive Backend -->
      <div class="glass-card feature-card">
        <div class="feature-icon icon-amber">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <h3 class="feature-title">Convex Reactive Backend</h3>
        <p class="feature-text">
          ACID-compliant serverless database providing real-time synchronization, automatic WebSocket subscriptions, and type-safe schema validation.
        </p>
        <span class="feature-tag">Real-Time Data Sync</span>
      </div>

      <!-- Card 6: Enterprise Security -->
      <div class="glass-card feature-card">
        <div class="feature-icon icon-cyan">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="feature-title">Enterprise Security Mesh</h3>
        <p class="feature-text">
          End-to-end cryptographic audit trails, granular role-based access control, and strict Content Security Policies enforced at the CDN edge.
        </p>
        <span class="feature-tag">SOC-2 Type II</span>
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 6rem 0;
    position: relative;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .section-desc {
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .feature-card {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid var(--border-subtle);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(6, 182, 212, 0.25);
  }

  .icon-pink {
    background: rgba(236, 72, 153, 0.12);
    color: var(--accent-pink);
    border: 1px solid rgba(236, 72, 153, 0.25);
  }

  .icon-indigo {
    background: rgba(99, 102, 241, 0.12);
    color: var(--accent-indigo);
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .icon-emerald {
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent-emerald);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .icon-amber {
    background: rgba(245, 158, 11, 0.12);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .feature-title {
    font-size: 1.25rem;
    color: #ffffff;
  }

  .feature-text {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    flex: 1;
  }

  .feature-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.2s ease;
  }

  .feature-link:hover {
    transform: translateX(4px);
  }

  .feature-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
