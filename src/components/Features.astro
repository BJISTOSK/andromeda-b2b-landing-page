---
const features = [
  {
    title: "Built for developers",
    description: "Built for engineers, developers, dreamers, thinkers and doers.",
    icon: "terminal",
  },
  {
    title: "Ease of use",
    description: "It's as easy as using an Apple, and as expensive as buying one.",
    icon: "ease",
  },
  {
    title: "Pricing like no other",
    description: "Our prices are best in the market. No cap, no lock, no credit card required.",
    icon: "dollar",
  },
  {
    title: "100% Uptime guarantee",
    description: "We just cannot be taken down by anyone.",
    icon: "cloud",
  },
  {
    title: "Multi-tenant Architecture",
    description: "You can simply share passwords instead of buying new seats",
    icon: "route",
  },
  {
    title: "24/7 Customer Support",
    description: "We are available a 100% of the time. Atleast our AI Agents are.",
    icon: "help",
  },
  {
    title: "Money back guarantee",
    description: "If you donot like EveryAI, we will convince you to like us.",
    icon: "bolt",
  },
  {
    title: "And everything else",
    description: "I just ran out of copy ideas. Accept my sincere apologies",
    icon: "heart",
  },
];
---

<section id="features" class="features-hover-section">
  <div class="container">
    <div class="features-grid">
      {features.map((feature, index) => (
        <div class:list={[
          'feature-cell',
          'group-feature',
          {
            'border-left': index === 0 || index === 4,
            'border-bottom': index < 4,
          }
        ]}>
          <!-- Hover Gradient Background -->
          <div class:list={[
            'hover-bg',
            index < 4 ? 'hover-bg-top' : 'hover-bg-bottom'
          ]}></div>

          <!-- Icon -->
          <div class="feature-icon-wrap">
            {feature.icon === 'terminal' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 9l3 3l-3 3"></path>
                <line x1="13" y1="15" x2="16" y2="15"></line>
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              </svg>
            )}
            {feature.icon === 'ease' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 20c8 0 10 -16 18 -16"></path>
                <path d="M6 4a3 3 0 0 0 6 0"></path>
                <path d="M12 20a3 3 0 0 0 6 0"></path>
              </svg>
            )}
            {feature.icon === 'dollar' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2"></path>
                <path d="M12 3v3m0 12v3"></path>
              </svg>
            )}
            {feature.icon === 'cloud' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.475 2.085 -4.482 4.657 -4.482c.393 -1.762 1.794 -3.2 3.675 -3.708c2.613 -.705 5.176 1.015 5.696 3.708c1.88 .508 3.282 1.946 3.675 3.708c2.572 0 4.657 2.007 4.657 4.483c0 2.475 -2.085 4.482 -4.657 4.482z"></path>
              </svg>
            )}
            {feature.icon === 'route' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="8 3 3 8 8 13"></polyline>
                <path d="M3 8h11a5 5 0 0 1 5 5v6"></path>
                <circle cx="19" cy="19" r="2"></circle>
              </svg>
            )}
            {feature.icon === 'help' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"></circle>
                <line x1="12" y1="17" x2="12" y2="17.01"></line>
                <path d="M12 13.5a1.5 1.5 0 0 1 1 -1.5a2.6 2.6 0 1 0 -3 -4"></path>
              </svg>
            )}
            {feature.icon === 'bolt' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="10" r="2"></circle>
                <line x1="6" y1="4" x2="6" y2="8"></line>
                <line x1="6" y1="12" x2="6" y2="20"></line>
                <circle cx="12" cy="16" r="2"></circle>
                <line x1="12" y1="4" x2="12" y2="14"></line>
                <line x1="12" y1="18" x2="12" y2="20"></line>
                <circle cx="18" cy="7" r="2"></circle>
                <line x1="18" y1="4" x2="18" y2="5"></line>
                <line x1="18" y1="9" x2="18" y2="20"></line>
              </svg>
            )}
            {feature.icon === 'heart' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
              </svg>
            )}
          </div>

          <!-- Title with Left Indicator Pill -->
          <div class="feature-title-wrap">
            <div class="left-indicator-pill"></div>
            <span class="feature-title-text">{feature.title}</span>
          </div>

          <!-- Description -->
          <p class="feature-description">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-hover-section {
    position: relative;
    z-index: 10;
    padding: 3.5rem 0 5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .feature-cell {
    display: flex;
    flex-direction: column;
    padding: 2.5rem 0;
    position: relative;
    border-right: 1px solid rgba(226, 232, 240, 0.9);
    transition: all 0.2s ease;
  }

  .feature-cell.border-left {
    border-left: 1px solid rgba(226, 232, 240, 0.9);
  }

  .feature-cell.border-bottom {
    border-bottom: 1px solid rgba(226, 232, 240, 0.9);
  }

  /* Hover gradient background */
  .hover-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .hover-bg-top {
    background: linear-gradient(to top, rgba(241, 245, 249, 0.9), transparent);
  }

  .hover-bg-bottom {
    background: linear-gradient(to bottom, rgba(241, 245, 249, 0.9), transparent);
  }

  .feature-cell:hover .hover-bg {
    opacity: 1;
  }

  /* Icon */
  .feature-icon-wrap {
    margin-bottom: 1rem;
    position: relative;
    z-index: 10;
    padding: 0 2.5rem;
    color: #475569;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .feature-cell:hover .feature-icon-wrap {
    color: #2563eb;
  }

  /* Title */
  .feature-title-wrap {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 10;
    padding: 0 2.5rem;
    display: flex;
    align-items: center;
  }

  .left-indicator-pill {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 1.5rem;
    width: 0.25rem;
    border-top-right-radius: 9999px;
    border-bottom-right-radius: 9999px;
    background-color: #cbd5e1;
    transition: all 0.2s ease;
    transform-origin: center;
  }

  .feature-cell:hover .left-indicator-pill {
    height: 2rem;
    background-color: #2563eb;
  }

  .feature-title-text {
    display: inline-block;
    color: #1e293b;
    transition: transform 0.2s ease;
  }

  .feature-cell:hover .feature-title-text {
    transform: translateX(0.5rem);
    color: #0f172a;
  }

  /* Description */
  .feature-description {
    font-size: 0.875rem;
    color: #475569;
    max-width: 20rem;
    position: relative;
    z-index: 10;
    padding: 0 2.5rem;
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature-cell {
      border-left: 1px solid rgba(226, 232, 240, 0.9);
      border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .feature-cell {
      padding: 2rem 0;
    }
    .feature-icon-wrap, .feature-title-wrap, .feature-description {
      padding: 0 1.5rem;
    }
  }
</style>
