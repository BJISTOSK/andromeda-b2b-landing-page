---
const currentYear = new Date().getFullYear();
---

<footer class="cruip-footer">
  <div class="container">
    <!-- Top Grid -->
    <div class="footer-grid">
      <!-- 1st Block: Brand Info -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">
          <div class="logo-mark">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="32" height="32" rx="8" fill="url(#foot-logo-grad)" />
              <path d="M16 6L24 20H8L16 6Z" fill="#ffffff" fill-opacity="0.9" />
              <circle cx="16" cy="17" r="3.5" fill="#2563eb" />
              <defs>
                <linearGradient id="foot-logo-grad" x1="0" y1="0" x2="32" y2="32">
                  <stop stop-color="#2563eb" />
                  <stop offset="1" stop-color="#4f46e5" />
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="brand-title">Andromeda<span class="brand-dot">.</span></span>
        </a>
        <p class="footer-tagline">
          The modern operating system for scaled B2B commerce. Powered by a decoupled static front-end and reactive cloud infrastructure.
        </p>
        <div class="footer-copyright">
          &copy; {currentYear} Andromeda B2B. All rights reserved.
        </div>
      </div>

      <!-- 2nd Block: Product -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">Product</h3>
        <ul class="footer-list">
          <li><a href="#features">Features</a></li>
          <li><a href="#integrations">Integrations</a></li>
          <li><a href="#pricing">Pricing & Plans</a></li>
          <li><a href="#changelog">Changelog</a></li>
        </ul>
      </div>

      <!-- 3rd Block: Infrastructure -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">Infrastructure</h3>
        <ul class="footer-list">
          <li><a href="https://astro.build" target="_blank" rel="noopener">Astro 7.x Engine</a></li>
          <li><a href="https://convex.dev" target="_blank" rel="noopener">Convex Reactive Cloud</a></li>
          <li><a href="https://pages.cloudflare.com" target="_blank" rel="noopener">Cloudflare Edge CDN</a></li>
          <li><a href="https://github.com/BJISTOSK/andromeda-b2b-landing-page" target="_blank" rel="noopener">GitHub Repository</a></li>
        </ul>
      </div>

      <!-- 4th Block: Security & Compliance -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">Security & SLAs</h3>
        <ul class="footer-list">
          <li class="status-item">
            <span class="status-dot status-dot-active"></span>
            <span>99.995% Uptime SLA</span>
          </li>
          <li><span class="footer-static-item">SOC-2 Type II Certified</span></li>
          <li><span class="footer-static-item">End-to-End Encryption</span></li>
          <li><a href="#privacy">Privacy Protocol</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <div class="footer-bottom-left">
        <span class="domain-tag">Domain: www.andromedab2b.com</span>
      </div>
      <div class="footer-bottom-links">
        <a href="#terms">Terms of Service</a>
        <a href="#privacy">Privacy Policy</a>
        <a href="#security">Security Vault</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .cruip-footer {
    background-color: #ffffff;
    border-top: 1px solid var(--border-subtle);
    padding: 4rem 0 2.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .logo-mark {
    width: 28px;
    height: 28px;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .brand-dot {
    color: var(--brand-blue);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-copyright {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-list a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-list a:hover {
    color: var(--brand-blue);
  }

  .footer-static-item {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    border-top: 1px solid var(--border-light);
    padding-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .domain-tag {
    font-family: monospace;
    color: var(--text-muted);
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-bottom-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-bottom-links a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-brand-col {
      grid-column: span 1;
    }
    .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
