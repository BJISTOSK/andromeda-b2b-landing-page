---
import Arrow from '../Arrow.astro';

const coreSlides = [
  {
    num: '1',
    phase: 'Thesis',
    name: 'Problem / Opportunity',
    question: 'What is broken in the real world?',
    subtitle: 'Market Urgency & Customer Pain',
    rule: 'Define an acute, quantifiable pain point. Show the patchwork workarounds customers currently hack together and the financial leakage it causes.',
    sequoiaBrief: 'Sequoia expects customer pain so acute that inaction has a clear, compounding cost. Avoid synthetic problems or speculative vitamins.',
    ycBrief: 'Kevin Hale principle: State the problem without jargon. If an eighth-grader cannot understand the pain within 10 seconds, the framing is broken.',
    fatalTrap: 'Presenting a "nice-to-have" tool rather than a mission-critical painkiller. If buyers are not losing money today, they will not pay tomorrow.',
    timeMetric: '41s average partner review',
    hotspot: 'Foundation'
  },
  {
    num: '2',
    phase: 'Invention',
    name: 'Solution & Value Prop',
    question: 'How do you directly neutralize the pain?',
    subtitle: 'The Asymmetric Wedge & Eureka Moment',
    rule: 'Show the eureka moment. Demonstrate visual proof of the solution curing the established problem with outcome-focused evidence.',
    sequoiaBrief: 'Focus on the structural breakthrough. Map the product architecture directly back to the pain points identified in Slide 1.',
    ycBrief: 'Radical clarity: 10x faster, 80% cheaper, or generating net new revenue. Avoid sprawling feature lists; prove the core magic.',
    fatalTrap: 'Showing 15 screenshots of a generic dashboard instead of the single proprietary workflow that creates undeniable value.',
    timeMetric: '77s heavy investor scrutiny',
    hotspot: 'High Scrutiny'
  },
  {
    num: '3',
    phase: 'Engine',
    name: 'Business Model & Unit Economics',
    question: 'How do the economics scale and compound?',
    subtitle: 'Pricing Engine & Gross Margins',
    rule: 'Detail your pricing architecture, average contract value (ACV), payback period, and sustainable gross margin profile.',
    sequoiaBrief: 'Prove that revenue scales non-linearly with headcount. Clarify sales velocity, customer payback cycles, and expansion potential.',
    ycBrief: 'Pick one transparent monetization model and own it. Avoid speculative multi-sided monetization schemes before achieving $1M ARR.',
    fatalTrap: 'Concealing churn, ignoring customer onboarding costs, or assuming enterprise deals close without an SDR team.',
    timeMetric: '83s top investor scrutiny',
    hotspot: 'Top Attention'
  },
  {
    num: '4',
    phase: 'Opportunity',
    name: 'Market Sizing & Bottom-Up TAM',
    question: 'How big is the prize if you win the beachhead?',
    subtitle: 'Defensible Bottom-Up Math',
    rule: 'Calculate target market size from the bottom up: actual countable buyers multiplied by verified ACV. Great startups often invent new categories.',
    sequoiaBrief: 'Never use top-down market slices (e.g. "Gartner says $50B, we will take 1%"). Calculate actual account density and realistic addressability.',
    ycBrief: 'Monopolize a fast-growing niche first. A 90% share of an exploding $500M market is vastly superior to 0.01% of a stagnant $50B market.',
    fatalTrap: 'Quoting trillion-dollar industry sizes without proving an initial accessible beachhead customer segment.',
    timeMetric: '32s sanity check',
    hotspot: 'Sanity Check'
  },
  {
    num: '5',
    phase: 'Fortress',
    name: 'Competition & Defensible Moat',
    question: 'Why won’t well-funded incumbents crush you?',
    subtitle: 'Asymmetric Advantage & Switching Costs',
    rule: 'Proactively map incumbents and direct alternatives. Explain your defensibility: proprietary data loops, workflow lock-in, or network effects.',
    sequoiaBrief: 'Acknowledge competitor strengths honestly. True defensibility comes from structural advantages incumbents cannot copy without cannibalization.',
    ycBrief: 'Never use a lazy 2x2 matrix where your logo has every checkmark and competitors have none. Investors find this naive and disqualifying.',
    fatalTrap: 'Saying "we have no competitors". VCs interpret this as either extreme founder ignorance or an absence of commercial demand.',
    timeMetric: '24s skimmed (absence is fatal)',
    hotspot: 'Red Flag Risk'
  },
  {
    num: '6',
    phase: 'Execution',
    name: 'Founding Team & Capital Ask',
    question: 'Why this team, and what does this capital achieve?',
    subtitle: 'Founder-Market Fit & 18-Month Milestones',
    rule: 'Highlight specific technical pedigree and domain experience. State exact capital sought and map the 18-month trajectory to Series A readiness.',
    sequoiaBrief: 'Connect capital deployment directly to milestone inflection: "This $3M provides 18 months of runway to reach $2M ARR and 15 enterprise logos".',
    ycBrief: 'Showcase founding builders only. Remove advisory boards, university logos, and vanity endorsements that distract from execution capability.',
    fatalTrap: 'Vague funding allocations like "60% marketing, 40% general corporate". Capital must be bound to verifiable de-risking milestones.',
    timeMetric: '48s pedigree & terms review',
    hotspot: 'Deal Terms'
  }
];
---

<div class="pitch-blueprint-section">
  <div class="blueprint-intro">
    <div class="blueprint-copy">
      <h3>The 6-Slide Universal Architecture</h3>
      <p>The core structure duplicated across Sequoia Capital, Y Combinator, and leading venture firms. Select any slide anchor to inspect the partner evaluation criteria and fatal traps.</p>
    </div>
    <div class="blueprint-telemetry-badge">
      <span>Framework standard</span>
      <strong>Universal 6-Slide Core</strong>
    </div>
  </div>

  <div class="blueprint-workspace">
    <!-- Slide Filmstrip / Waypoint Strip -->
    <div class="blueprint-strip-wrap" role="tablist" aria-label="Universal 6-Slide Architecture">
      <div class="blueprint-strip">
        {coreSlides.map((slide, index) => (
          <button 
            class:list={['slide-waypoint-card', { active: index === 0 }]}
            data-slide-index={index}
            role="tab"
            aria-selected={index === 0}
            id={`tab-slide-${index}`}
            aria-controls="blueprint-dossier"
            tabindex={index === 0 ? 0 : -1}
          >
            <div class="waypoint-top">
              <span class="waypoint-phase">{slide.phase}</span>
              <span class="waypoint-hotspot">{slide.hotspot}</span>
            </div>
            <strong class="waypoint-num">{slide.num}</strong>
            <span class="waypoint-title">{slide.name}</span>
            <span class="waypoint-time">{slide.timeMetric}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Slide Dossier -->
    <div class="blueprint-dossier" id="blueprint-dossier" role="tabpanel" aria-labelledby="tab-slide-0">
      <div class="dossier-masthead">
        <div class="dossier-header-row">
          <h4 id="disp-slide-title">Problem / Opportunity</h4>
          <span class="dossier-time-tag" id="disp-slide-time">41s average partner review</span>
        </div>
        <div class="dossier-meta">
          <span class="dossier-step-tag" id="disp-slide-step">Slide 1 of 6 · Phase: Thesis</span>
        </div>
        <p class="dossier-question" id="disp-slide-question">"What is broken in the real world?"</p>
        <p class="dossier-rule" id="disp-slide-rule">
          Define an acute, quantifiable pain point. Show the patchwork workarounds customers currently hack together and the financial leakage it causes.
        </p>
      </div>

      <div class="dossier-grid">
        <div class="dossier-card sequoia-card">
          <div class="card-header-bar">
            <span>Sequoia Capital Lens</span>
          </div>
          <p id="disp-slide-sequoia">
            Sequoia expects customer pain so acute that inaction has a clear, compounding cost. Avoid synthetic problems or speculative vitamins.
          </p>
        </div>

        <div class="dossier-card yc-card">
          <div class="card-header-bar">
            <span>Y Combinator Lens</span>
          </div>
          <p id="disp-slide-yc">
            Kevin Hale principle: State the problem without jargon. If an eighth-grader cannot understand the pain within 10 seconds, the framing is broken.
          </p>
        </div>
      </div>

      <div class="dossier-fatal-banner">
        <div class="fatal-icon" aria-hidden="true">!</div>
        <div class="fatal-text-group">
          <strong>The fatal rejection trap</strong>
          <p id="disp-slide-fatal">
            Presenting a "nice-to-have" tool rather than a mission-critical painkiller. If buyers are not losing money today, they will not pay tomorrow.
          </p>
        </div>
      </div>

      <div class="dossier-footer">
        <div class="dossier-pagers">
          <button id="btn-prev-slide" class="pager-btn" aria-label="Previous slide">← Previous slide</button>
          <button id="btn-next-slide" class="pager-btn" aria-label="Next slide">Next slide →</button>
        </div>
        <a href="/pitch-deck/6-slides-core-structure" class="dossier-guide-link">
          Read full 6-slide dissection <Arrow diagonal />
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const slidesData = [
    {
      num: '1',
      phase: 'Thesis',
      name: 'Problem / Opportunity',
      question: '"What is broken in the real world?"',
      rule: 'Define an acute, quantifiable pain point. Show the patchwork workarounds customers currently hack together and the financial leakage it causes.',
      sequoia: 'Sequoia expects customer pain so acute that inaction has a clear, compounding cost. Avoid synthetic problems or speculative vitamins.',
      yc: 'Kevin Hale principle: State the problem without jargon. If an eighth-grader cannot understand the pain within 10 seconds, the framing is broken.',
      fatal: 'Presenting a "nice-to-have" tool rather than a mission-critical painkiller. If buyers are not losing money today, they will not pay tomorrow.',
      time: '41s average partner review'
    },
    {
      num: '2',
      phase: 'Invention',
      name: 'Solution & Value Prop',
      question: '"How do you directly neutralize the pain?"',
      rule: 'Show the eureka moment. Demonstrate visual proof of the solution curing the established problem with outcome-focused evidence.',
      sequoia: 'Focus on the structural breakthrough. Map the product architecture directly back to the pain points identified in Slide 1.',
      yc: 'Radical clarity: 10x faster, 80% cheaper, or generating net new revenue. Avoid sprawling feature lists; prove the core magic.',
      fatal: 'Showing 15 screenshots of a generic dashboard instead of the single proprietary workflow that creates undeniable value.',
      time: '77s heavy investor scrutiny'
    },
    {
      num: '3',
      phase: 'Engine',
      name: 'Business Model & Unit Economics',
      question: '"How do the economics scale and compound?"',
      rule: 'Detail your pricing architecture, average contract value (ACV), payback period, and sustainable gross margin profile.',
      sequoia: 'Prove that revenue scales non-linearly with headcount. Clarify sales velocity, customer payback cycles, and expansion potential.',
      yc: 'Pick one transparent monetization model and own it. Avoid speculative multi-sided monetization schemes before achieving $1M ARR.',
      fatal: 'Concealing churn, ignoring customer onboarding costs, or assuming enterprise deals close without an SDR team.',
      time: '83s top investor scrutiny'
    },
    {
      num: '4',
      phase: 'Opportunity',
      name: 'Market Sizing & Bottom-Up TAM',
      question: '"How big is the prize if you win the beachhead?"',
      rule: 'Calculate target market size from the bottom up: actual countable buyers multiplied by verified ACV. Great startups often invent new categories.',
      sequoia: 'Never use top-down market slices (e.g. "Gartner says $50B, we will take 1%"). Calculate actual account density and realistic addressability.',
      yc: 'Monopolize a fast-growing niche first. A 90% share of an exploding $500M market is vastly superior to 0.01% of a stagnant $50B market.',
      fatal: 'Quoting trillion-dollar industry sizes without proving an initial accessible beachhead customer segment.',
      time: '32s sanity check'
    },
    {
      num: '5',
      phase: 'Fortress',
      name: 'Competition & Defensible Moat',
      question: '"Why won’t well-funded incumbents crush you?"',
      rule: 'Proactively map incumbents and direct alternatives. Explain your defensibility: proprietary data loops, workflow lock-in, or network effects.',
      sequoia: 'Acknowledge competitor strengths honestly. True defensibility comes from structural advantages incumbents cannot copy without cannibalization.',
      yc: 'Never use a lazy 2x2 matrix where your logo has every checkmark and competitors have none. Investors find this naive and disqualifying.',
      fatal: 'Saying "we have no competitors". VCs interpret this as either extreme founder ignorance or an absence of commercial demand.',
      time: '24s skimmed (absence is fatal)'
    },
    {
      num: '6',
      phase: 'Execution',
      name: 'Founding Team & Capital Ask',
      question: '"Why this team, and what does this capital achieve?"',
      rule: 'Highlight specific technical pedigree and domain experience. State exact capital sought and map the 18-month trajectory to Series A readiness.',
      sequoia: 'Connect capital deployment directly to milestone inflection: "This $3M provides 18 months of runway to reach $2M ARR and 15 enterprise logos".',
      yc: 'Showcase founding builders only. Remove advisory boards, university logos, and vanity endorsements that distract from execution capability.',
      fatal: 'Vague funding allocations like "60% marketing, 40% general corporate". Capital must be bound to verifiable de-risking milestones.',
      time: '48s pedigree & terms review'
    }
  ];

  let activeIndex = 0;
  const cards = document.querySelectorAll<HTMLButtonElement>('.slide-waypoint-card');
  const dispStep = document.getElementById('disp-slide-step');
  const dispTime = document.getElementById('disp-slide-time');
  const dispTitle = document.getElementById('disp-slide-title');
  const dispQuestion = document.getElementById('disp-slide-question');
  const dispRule = document.getElementById('disp-slide-rule');
  const dispSequoia = document.getElementById('disp-slide-sequoia');
  const dispYc = document.getElementById('disp-slide-yc');
  const dispFatal = document.getElementById('disp-slide-fatal');
  const btnPrev = document.getElementById('btn-prev-slide');
  const btnNext = document.getElementById('btn-next-slide');

  function renderSlide(index: number) {
    activeIndex = (index + slidesData.length) % slidesData.length;
    const slide = slidesData[activeIndex];

    cards.forEach((card, idx) => {
      const isSelected = idx === activeIndex;
      card.classList.toggle('active', isSelected);
      card.setAttribute('aria-selected', String(isSelected));
      card.tabIndex = isSelected ? 0 : -1;
    });

    if (dispStep) dispStep.textContent = `Slide ${slide.num} of 6 · Phase: ${slide.phase}`;
    if (dispTime) dispTime.textContent = slide.time;
    if (dispTitle) dispTitle.textContent = slide.name;
    if (dispQuestion) dispQuestion.textContent = slide.question;
    if (dispRule) dispRule.textContent = slide.rule;
    if (dispSequoia) dispSequoia.textContent = slide.sequoia;
    if (dispYc) dispYc.textContent = slide.yc;
    if (dispFatal) dispFatal.textContent = slide.fatal;
  }

  cards.forEach((card, idx) => {
    card.addEventListener('click', () => renderSlide(idx));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        const next = (idx + 1) % cards.length;
        renderSlide(next);
        cards[next].focus();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = (idx + cards.length - 1) % cards.length;
        renderSlide(prev);
        cards[prev].focus();
      }
    });
  });

  btnPrev?.addEventListener('click', () => renderSlide(activeIndex - 1));
  btnNext?.addEventListener('click', () => renderSlide(activeIndex + 1));
</script>

<style>
  .pitch-blueprint-section {
    margin-block: 56px 64px;
    color: var(--fg);
  }
  .blueprint-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 28px;
  }
  .blueprint-copy h3 {
    font-size: 32px;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: 8px;
  }
  .blueprint-copy p {
    font-size: 15px;
    color: var(--fg-2);
    max-width: 60ch;
    line-height: 1.55;
  }
  .blueprint-telemetry-badge {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
  }
  .blueprint-telemetry-badge span {
    font-size: 13px;
    color: var(--fg-3);
  }
  .blueprint-telemetry-badge strong {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }

  .blueprint-workspace {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Slide Waypoint Strip */
  .blueprint-strip-wrap {
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .blueprint-strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(180px, 1fr));
    gap: 12px;
  }
  .slide-waypoint-card {
    background: var(--bg-raised);
    border: 0;
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.18s, transform 0.18s;
  }
  .slide-waypoint-card:hover {
    background: #232825;
    transform: translateY(-2px);
  }
  .slide-waypoint-card.active {
    background: #2a312c;
  }
  .waypoint-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  .waypoint-phase {
    color: var(--fg-3);
  }
  .waypoint-hotspot {
    color: var(--accent);
    font-weight: 500;
  }
  .waypoint-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: var(--fg);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .waypoint-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.35;
  }
  .waypoint-time {
    font-size: 13px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
    margin-top: auto;
  }

  /* Active Dossier Panel */
  .blueprint-dossier {
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .dossier-masthead {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .dossier-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .dossier-meta {
    display: flex;
    align-items: center;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .dossier-step-tag {
    color: var(--accent);
    font-weight: 500;
  }
  .dossier-time-tag {
    color: var(--fg-3);
  }
  .dossier-masthead h4 {
    font-size: 32px;
    letter-spacing: -0.025em;
    color: var(--fg);
  }
  .dossier-question {
    font-size: 18px;
    color: var(--fg);
    font-style: italic;
    line-height: 1.45;
  }
  .dossier-rule {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-2);
    max-width: 72ch;
  }

  /* Dossier Grid */
  .dossier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .dossier-card {
    background: #141615;
    border-radius: var(--radius-xs);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card-header-bar span {
    font-size: 13px;
    font-weight: 500;
  }
  .sequoia-card .card-header-bar span {
    color: var(--accent);
  }
  .yc-card .card-header-bar span {
    color: #dfdcd3;
  }
  .dossier-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
  }

  /* Fatal Trap Banner */
  .dossier-fatal-banner {
    display: flex;
    gap: 16px;
    background: #241917;
    border-radius: var(--radius-xs);
    padding: 18px 22px;
    align-items: flex-start;
  }
  .fatal-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e28a7e;
    color: #141615;
    font-weight: 700;
    font-size: 14px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .fatal-text-group strong {
    font-size: 13px;
    font-weight: 500;
    color: #e28a7e;
    display: block;
    margin-bottom: 4px;
  }
  .fatal-text-group p {
    font-size: 14px;
    line-height: 1.55;
    color: #e0d0ce;
  }

  /* Dossier Footer */
  .dossier-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
  }
  .dossier-pagers {
    display: flex;
    gap: 12px;
  }
  .pager-btn {
    background: #141615;
    border: 0;
    color: var(--fg-2);
    padding: 8px 16px;
    border-radius: var(--radius-xs);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
  }
  .pager-btn:hover {
    background: #272d2a;
    color: var(--fg);
  }
  .dossier-guide-link {
    font-size: 13px;
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: color 0.18s;
  }
  .dossier-guide-link:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .blueprint-intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .blueprint-telemetry-badge {
      text-align: left;
    }
    .blueprint-strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .dossier-grid {
      grid-template-columns: 1fr;
    }
    .dossier-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .blueprint-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
