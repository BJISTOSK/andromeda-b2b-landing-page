---
import type { PitchDeckArticle } from '../../data/pitchDeckData';

interface Props {
  article: PitchDeckArticle;
  totalArticles: number;
}

const { article, totalArticles } = Astro.props;
---

<div class="reader-top-bar" id="reader-top-bar">
  <!-- Scroll Progress Indicator -->
  <div class="reading-progress-track" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class="reader-bar-content container">
    <div class="reader-left-nav">
      <a href="/pitch-deck" class="back-to-hub-btn" id="back-to-hub-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to All Articles</span>
      </a>

      <div class="reader-breadcrumbs">
        <span class="crumb-sep">/</span>
        <span class="crumb-category">{article.category}</span>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Article {article.num} of {totalArticles}</span>
      </div>
    </div>

    <div class="reader-right-meta">
      <span class="reader-badge">{article.stage}</span>
      <span class="reader-time">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {article.readTime}
      </span>
      <button class="reader-share-btn" id="reader-share-btn" title="Copy article link" aria-label="Copy link">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        <span class="share-text">Share</span>
      </button>
    </div>
  </div>
</div>

<script>
  // Reading Progress Bar
  const progressBar = document.getElementById('reading-progress-bar');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
    }, { passive: true });
  }

  // Copy Link Button
  const shareBtn = document.getElementById('reader-share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const textSpan = shareBtn.querySelector('.share-text');
        if (textSpan) {
          const orig = textSpan.textContent;
          textSpan.textContent = 'Copied!';
          shareBtn.classList.add('copied');
          setTimeout(() => {
            textSpan.textContent = orig;
            shareBtn.classList.remove('copied');
          }, 2000);
        }
      } catch (e) {
        console.error('Failed to copy', e);
      }
    });
  }
</script>

<style>
  .reader-top-bar {
    position: sticky;
    top: 4.5rem;
    z-index: 40;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #e2e8f0;
    transition: all 0.2s ease;
  }

  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(226, 232, 240, 0.6);
    z-index: 9999;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
    transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reader-bar-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .reader-left-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .back-to-hub-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .back-to-hub-btn:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    transform: translateX(-2px);
  }

  .reader-breadcrumbs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #64748b;
  }

  .crumb-sep {
    color: #cbd5e1;
  }

  .crumb-category {
    font-weight: 600;
    color: #3b82f6;
  }

  .crumb-current {
    color: #475569;
    font-weight: 500;
  }

  .reader-right-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reader-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    letter-spacing: 0.02em;
  }

  .reader-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: #64748b;
    font-weight: 500;
  }

  .reader-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #475569;
    background: transparent;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .reader-share-btn:hover {
    background: #f8fafc;
    color: #0f172a;
    border-color: #cbd5e1;
  }

  .reader-share-btn.copied {
    background: #ecfdf5;
    color: #059669;
    border-color: #a7f3d0;
  }

  @media (max-width: 768px) {
    .reader-top-bar {
      top: 4rem;
    }
    .reader-breadcrumbs {
      display: none;
    }
    .reader-badge {
      display: none;
    }
  }
</style>
