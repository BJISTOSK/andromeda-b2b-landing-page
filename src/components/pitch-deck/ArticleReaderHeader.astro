---
import type { PitchDeckArticle } from '../../data/pitchDeckData';
interface Props { article: PitchDeckArticle; totalArticles: number; }
const { article, totalArticles } = Astro.props;
---
<div class="reader-top-bar">
  <div class="reading-progress-track" aria-hidden="true"><div id="reading-progress-bar"></div></div>
  <div class="container reader-bar-content"><a href="/pitch-deck" class="reader-back"><span aria-hidden="true">←</span> The library</a><span class="reader-position">{article.category} <span>/</span> Article {article.num} of {totalArticles}</span><span class="reader-time">{article.readTime}</span><button id="reader-share-btn" class="reader-share-btn" aria-label="Copy article link">Copy link <span aria-hidden="true">↗</span></button><span class="sr-only" id="share-status" role="status"></span></div>
</div>
<script>
  const progressBar = document.getElementById('reading-progress-bar');
  function updateProgress() {
    const article = document.querySelector<HTMLElement>('.article-block');
    if (!progressBar || !article) return;
    const top = article.getBoundingClientRect().top + window.scrollY;
    const distance = article.offsetHeight - window.innerHeight + 150;
    const progress = distance > 0 ? (window.scrollY - top + 150) / distance * 100 : 100;
    progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();
  const share = document.getElementById('reader-share-btn');
  const status = document.getElementById('share-status');
  share?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(window.location.href); share.textContent = 'Link copied'; if (status) status.textContent = 'Article link copied.'; setTimeout(() => { share.textContent = 'Copy link'; }, 2200); }
    catch { if (status) status.textContent = 'Copy the article address from your browser to share it.'; }
  });
</script>
<style>
  .reader-top-bar { position: sticky; top: var(--nav-h); z-index: 40; background: var(--bg); }
  .reader-bar-content { display: flex; align-items: center; gap: 24px; min-height: 56px; }
  .reader-back { display: flex; gap: 8px; text-decoration: none; font-size: 13px; color: var(--fg-2); }
  .reader-back:hover { color: var(--accent); }
  .reader-position { font-size: 13px; color: var(--fg-3); margin-right: auto; font-variant-numeric: tabular-nums; }
  .reader-position > span { padding-inline: 8px; }
  .reader-time { font-size: 13px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .reader-share-btn { background: transparent; border: 0; font-size: 13px; color: var(--fg-2); display: flex; gap: 8px; padding: 8px 0; cursor: pointer; }
  .reader-share-btn:hover { color: var(--accent); }
  .reading-progress-track { position: absolute; bottom: -1px; height: 2px; width: 100%; pointer-events: none; background: var(--line); }
  #reading-progress-bar { background: var(--accent); height: 100%; width: 0; }
  @media(max-width: 760px) { .reader-position { display: none; }.reader-time { margin-left: auto; }.reader-bar-content { gap: 18px; min-height: 52px; } }
</style>
