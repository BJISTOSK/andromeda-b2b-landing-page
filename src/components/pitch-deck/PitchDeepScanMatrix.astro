---

<div class="pitch-matrix-section">
  <div class="matrix-intro">
    <div class="matrix-copy">
      <h3>12-Framework Deep Scan Matrix</h3>
      <p>Compare institutional expectations, partner evaluation criteria, and fatal rejection traps across all 12 venture models.</p>
    </div>
    <div class="matrix-meta-count">
      <span>Frameworks analyzed</span>
      <strong>12 Proven VC Standards</strong>
    </div>
  </div>

  <div class="matrix-workspace">
    <!-- Framework Selector Strip -->
    <div class="matrix-selector-strip" role="tablist" aria-label="Select VC framework to inspect">
      {frameworksDeepScan.map((fw, index) => (
        <button 
          class:list={['fw-chip-card', { active: index === 0 }]}
          data-slug={fw.slug}
          role="tab"
          aria-selected={index === 0}
          id={`tab-fw-${fw.slug}`}
          aria-controls="matrix-dossier"
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="chip-stage">{fw.stage}</span>
          <strong class="chip-name">{fw.name}</strong>
          <span class="chip-slides">{fw.slides}</span>
        </button>
      ))}
    </div>

    <!-- Active Audit Dossier -->
    <div class="matrix-dossier" id="matrix-dossier" role="tabpanel" aria-labelledby="tab-fw-6-slides-core-structure">
      <div class="dossier-topbar">
        <div class="dossier-headline-group">
          <h4 id="mat-fw-name">{frameworksDeepScan[0].name}</h4>
          <div class="dossier-badges">
            <span class="dossier-badge origin" id="mat-fw-origin">{frameworksDeepScan[0].origin}</span>
            <span class="dossier-badge" id="mat-fw-stage">{frameworksDeepScan[0].stage}</span>
            <span class="dossier-badge" id="mat-fw-slides">{frameworksDeepScan[0].slides}</span>
          </div>
        </div>
        <a id="mat-fw-link" href={`/pitch-deck/${frameworksDeepScan[0].slug}`} class="dossier-cta-btn">
          Read Full Dissection <Arrow diagonal />
        </a>
      </div>

      <div class="dossier-critique-grid">
        <div class="critique-card test-card">
          <span class="critique-label">The core VC evaluation test</span>
          <p id="mat-fw-test">{frameworksDeepScan[0].vcTest}</p>
        </div>

        <div class="critique-card trap-card">
          <span class="critique-label trap">The #1 fatal rejection trap</span>
          <p id="mat-fw-flaw">{frameworksDeepScan[0].fatalFlaw}</p>
        </div>
      </div>

      <!-- Slide Filmstrip Architecture -->
      <div class="filmstrip-architecture">
        <div class="filmstrip-header">
          <span class="filmstrip-title">Mandated slide progression</span>
          <span class="filmstrip-count" id="mat-fw-count">{frameworksDeepScan[0].slideList.length} slides in sequence</span>
        </div>
        <div class="filmstrip-track" id="mat-fw-slides-track">
          {frameworksDeepScan[0].slideList.map((slide, sIdx) => (
            <div class="filmstrip-tile">
              <span class="tile-index">{sIdx + 1}</span>
              <strong class="tile-name">{slide}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

