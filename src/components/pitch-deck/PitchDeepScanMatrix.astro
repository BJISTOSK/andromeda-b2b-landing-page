    }
  ];

  const items = document.querySelectorAll<HTMLButtonElement>('.scan-select-item');
  const sheetStage = document.getElementById('sheet-stage');
  const sheetSlides = document.getElementById('sheet-slides');
  const sheetOrigin = document.getElementById('sheet-origin');
  const sheetTitle = document.getElementById('sheet-title');
  const sheetVcTest = document.getElementById('sheet-vc-test');
  const sheetFatal = document.getElementById('sheet-fatal-flaw');
  const sheetSlideList = document.getElementById('sheet-slide-list');
  const sheetLink = document.getElementById('sheet-article-link') as HTMLAnchorElement | null;
  const sheetDisplay = document.getElementById('deep-scan-display');

  function selectFramework(slug: string) {
    const fw = scanData.find(f => f.slug === slug);
    if (!fw) return;

    items.forEach(btn => {
      const match = btn.getAttribute('data-slug') === slug;
      btn.classList.toggle('active', match);
      btn.setAttribute('aria-selected', String(match));
    });

    if (sheetDisplay) sheetDisplay.setAttribute('aria-labelledby', `tab-fw-${slug}`);
    if (sheetStage) sheetStage.textContent = fw.stage;
    if (sheetSlides) sheetSlides.textContent = fw.slides;
    if (sheetOrigin) sheetOrigin.textContent = fw.origin;
    if (sheetTitle) sheetTitle.textContent = fw.name;
    if (sheetVcTest) sheetVcTest.textContent = fw.vcTest;
    if (sheetFatal) sheetFatal.textContent = fw.fatalFlaw;
    if (sheetLink) sheetLink.href = `/pitch-deck/${fw.slug}`;

    if (sheetSlideList) {
      sheetSlideList.innerHTML = fw.slideList.map(slide => `<li><span>${slide}</span></li>`).join('');
    }
  }

  items.forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug');
      if (slug) selectFramework(slug);
    });
  });
