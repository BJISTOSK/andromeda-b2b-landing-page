    }
  ];

  const chips = document.querySelectorAll<HTMLButtonElement>('.fw-chip-card');
  const matOrigin = document.getElementById('mat-fw-origin');
  const matStage = document.getElementById('mat-fw-stage');
  const matSlides = document.getElementById('mat-fw-slides');
  const matName = document.getElementById('mat-fw-name');
  const matTest = document.getElementById('mat-fw-test');
  const matFlaw = document.getElementById('mat-fw-flaw');
  const matCount = document.getElementById('mat-fw-count');
  const matTrack = document.getElementById('mat-fw-slides-track');
  const matLink = document.getElementById('mat-fw-link') as HTMLAnchorElement | null;
  const dossier = document.getElementById('matrix-dossier');

  function selectFramework(slug: string) {
    const fw = scanData.find(f => f.slug === slug);
    if (!fw) return;

    chips.forEach(chip => {
      const isMatch = chip.getAttribute('data-slug') === slug;
      chip.classList.toggle('active', isMatch);
      chip.setAttribute('aria-selected', String(isMatch));
      chip.tabIndex = isMatch ? 0 : -1;
    });

    if (dossier) dossier.setAttribute('aria-labelledby', `tab-fw-${slug}`);
    if (matOrigin) matOrigin.textContent = fw.origin;
    if (matStage) matStage.textContent = fw.stage;
    if (matSlides) matSlides.textContent = fw.slides;
    if (matName) matName.textContent = fw.name;
    if (matTest) matTest.textContent = fw.vcTest;
    if (matFlaw) matFlaw.textContent = fw.fatalFlaw;
    if (matCount) matCount.textContent = `${fw.slideList.length} slides in sequence`;
    if (matLink) matLink.href = `/pitch-deck/${fw.slug}`;

    if (matTrack) {
      matTrack.innerHTML = fw.slideList.map((slide, i) => `
        <div class="filmstrip-tile">
          <span class="tile-index">${i + 1}</span>
          <strong class="tile-name">${slide}</strong>
        </div>
      `).join('');
    }
  }

  chips.forEach((chip, idx) => {
    chip.addEventListener('click', () => {
      const slug = chip.getAttribute('data-slug');
      if (slug) selectFramework(slug);
    });

    chip.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        const next = (idx + 1) % chips.length;
        const nextSlug = chips[next].getAttribute('data-slug');
        if (nextSlug) {
          selectFramework(nextSlug);
          chips[next].focus();
        }
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = (idx + chips.length - 1) % chips.length;
        const prevSlug = chips[prev].getAttribute('data-slug');
        if (prevSlug) {
          selectFramework(prevSlug);
          chips[prev].focus();
        }
      }
    });
  });
</script>

<style>
  .pitch-matrix-section {
    margin-block: 48px 64px;
    color: var(--fg);
  }
  .matrix-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 28px;
  }
  .matrix-copy h3 {
    font-size: 32px;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: 8px;
  }
  .matrix-copy p {
    font-size: 15px;
    color: var(--fg-2);
    max-width: 60ch;
    line-height: 1.55;
  }
  .matrix-meta-count {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
  }
  .matrix-meta-count span {
    font-size: 13px;
    color: var(--fg-3);
  }
  .matrix-meta-count strong {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }

  .matrix-workspace {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Framework Selector Strip */
  .matrix-selector-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }
  .fw-chip-card {
    background: var(--bg-raised);
    border: 0;
    border-radius: var(--radius-xs);
    padding: 14px 16px;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: background 0.18s, transform 0.18s;
  }
  .fw-chip-card:hover {
    background: #232825;
    transform: translateY(-2px);
  }
  .fw-chip-card.active {
    background: #272d2a;
  }
  .chip-stage {
    font-size: 13px;
    color: var(--accent);
  }
  .chip-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.35;
  }
  .chip-slides {
    font-size: 13px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }

  /* Active Dossier */
  .matrix-dossier {
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .dossier-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .dossier-headline-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .dossier-badges {
    display: flex;
    gap: 8px;
  }
  .dossier-badge {
    font-size: 13px;
    background: #141615;
    padding: 4px 10px;
    border-radius: 4px;
    color: var(--fg-2);
  }
  .dossier-badge.origin {
    color: var(--accent);
    font-weight: 500;
  }
  .dossier-headline-group h4 {
    font-size: 32px;
    letter-spacing: -0.025em;
    color: var(--fg);
  }
  .dossier-cta-btn {
    background: #141615;
    color: var(--fg);
