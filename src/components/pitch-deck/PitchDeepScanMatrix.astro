<style>
  .deep-scan-component {
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 36px 32px;
    margin-block: 48px;
    color: var(--fg);
  }
  .deep-scan-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 24px;
  }
  .deep-scan-kicker {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    display: block;
    margin-bottom: 6px;
  }
  .deep-scan-header h3 {
    font-size: 26px;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .deep-scan-header p {
    font-size: 15px;
    color: var(--fg-2);
    max-width: 58ch;
    line-height: 1.5;
  }
  .scanner-meta-pill {
    display: flex;
    gap: 16px;
    background: #141615;
    padding: 10px 16px;
    border-radius: var(--radius-xs);
    font-size: 13px;
    color: var(--fg-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .deep-scan-layout {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 32px;
    padding-top: 32px;
  }

  /* Framework Selector List */
  .framework-selector-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 640px;
    overflow-y: auto;
    padding-right: 8px;
  }
  .scan-select-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #141615;
    border: 0;
    border-radius: var(--radius-xs);
    padding: 12px 14px;
    text-align: left;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
  }
  .scan-select-item:hover {
    background: #202422;
  }
  .scan-select-item.active {
    background: #272d2a;
    color: var(--fg);
  }
  .item-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .item-num {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .item-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
    display: block;
    line-height: 1.3;
  }
  .item-sub {
    font-size: 13px;
    color: var(--fg-3);
  }
  .item-focus-badge {
    font-size: 13px;
    color: var(--fg-3);
    background: var(--bg-raised);
    padding: 4px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  /* Diagnostic Display Sheet */
  .deep-scan-display {
    background: #141615;
    border-radius: var(--radius-sm);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .sheet-topline {
    padding-bottom: 20px;
  }
  .sheet-meta-tags {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }
  .sheet-badge {
    font-size: 13px;
    background: var(--bg-raised);
    padding: 4px 10px;
    border-radius: 4px;
    color: var(--fg-2);
  }
  .sheet-badge.origin {
    color: var(--accent);
  }
  .sheet-topline h4 {
    font-size: 26px;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .sheet-sections {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-block: 24px;
  }
  .diagnostic-card {
    background: var(--bg-raised);
    padding: 18px;
    border-radius: var(--radius-xs);
  }
  .card-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--accent);
    display: block;
    margin-bottom: 6px;
  }
  .card-label.fatal {
    color: #e28a7e;
  }
  .diagnostic-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
  }

  .slide-architecture-block {
    background: var(--bg-raised);
    padding: 18px;
    border-radius: var(--radius-xs);
  }
  .slide-seq-list {
    margin: 10px 0 0 18px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px 16px;
  }
  .slide-seq-list li {
    font-size: 13px;
    color: var(--fg-2);
    line-height: 1.4;
  }

  .sheet-action-footer {
