---
import Arrow from '../Arrow.astro';

const heatmapData = [
  { section: 'Business Model & Economics', seconds: 83, pct: 100, note: 'Top scrutiny: ACV, CAC payback, and gross margins', status: 'Crucial' },
  { section: 'Product Experience & Workflow', seconds: 77, pct: 93, note: 'Heavy focus: High-fidelity screens and UX proof', status: 'Crucial' },
  { section: 'Traction Velocity & Milestones', seconds: 64, pct: 77, note: 'Growth slope: Revenue or active usage trajectory', status: 'High' },
  { section: 'Team & Founder Advantage', seconds: 48, pct: 58, note: 'Founder-market fit: Past accomplishments & domain edge', status: 'High' },
  { section: 'Acute Problem & Workarounds', seconds: 41, pct: 49, note: 'Validation of acute customer balance sheet pain', status: 'Moderate' },
  { section: 'The "Why Now?" Inflection', seconds: 36, pct: 43, note: 'Technological or regulatory market catalyst', status: 'Moderate' },
  { section: 'Purpose & Elevator Hook', seconds: 33, pct: 40, note: 'Immediate category mental filing', status: 'Moderate' },
  { section: 'Market Sizing (Bottom-up TAM)', seconds: 32, pct: 39, note: 'Bottom-up math sanity check', status: 'Quick glance' },
  { section: 'Competition & Defensibility', seconds: 24, pct: 29, note: 'Quickly skimmed; absence is an instant red flag', status: 'Sanity check' }
];

const animalData = [
  { animal: 'Whales', acv: '$1,000,000+', count: '100 customers', model: 'Executive enterprise field sales, custom security, multi-year contracts', share: 'Top Tier Enterprise' },
  { animal: 'Elephants', acv: '$100,000', count: '1,000 customers', model: 'Enterprise AE + SDR motion, dedicated customer success, POCs', share: 'Enterprise B2B' },
  { animal: 'Deer', acv: '$10,000', count: '10,000 customers', model: 'Inside sales, demo calls, automated trial onboarding', share: 'Mid-Market' },
  { animal: 'Rabbits', acv: '$1,000', count: '100,000 customers', model: 'Self-serve credit card signup, product-led growth (PLG)', share: 'SMB' },
  { animal: 'Mice', acv: '$100', count: '1,000,000 customers', model: 'Pure viral product loop, freemium conversion, zero touch', share: 'Prosumer' }
];
---

<div class="pitch-charts-component">
  <div class="charts-header">
    <div>
      <h3>Venture Behavior & Sizing Analytics</h3>
      <p>Data-backed insights from thousands of institutional deck reviews and SaaS market models.</p>
    </div>
    <div class="chart-tab-controls" role="tablist" aria-label="Analytical charts">
      <button class="chart-tab-btn active" role="tab" aria-selected="true" id="tab-chart-heatmap" aria-controls="panel-chart-heatmap">
        DocSend Attention Heatmap
      </button>
      <button class="chart-tab-btn" role="tab" aria-selected="false" id="tab-chart-animals" aria-controls="panel-chart-animals">
        Point Nine SaaS Animal Sizing
      </button>
    </div>
  </div>

  <!-- Panel 1: DocSend Heatmap -->
  <div class="chart-panel" id="panel-chart-heatmap" role="tabpanel" aria-labelledby="tab-chart-heatmap">
    <div class="panel-intro-bar">
      <div>
        <h4>Investor Attention per Slide (Seconds Spent)</h4>
        <p>DocSend study of 3,000+ decks: where institutional investors linger versus what they skim.</p>
      </div>
      <div class="benchmark-pill">
        <span>Funded Avg: <strong>3m 48s</strong></span>
        <span>Unfunded Avg: <strong>2m 13s</strong></span>
      </div>
    </div>

    <div class="heatmap-bars-list" data-ui>
      {heatmapData.map(item => (
        <div class="heatmap-row">
          <div class="row-label-group">
            <span class="row-section-name">{item.section}</span>
            <span class="row-note">{item.note}</span>
          </div>
          <div class="bar-track-wrap">
            <div class="bar-fill-track">
              <div class="bar-fill-progress" style={`width: ${item.pct}%;`}></div>
            </div>
            <div class="bar-metrics">
              <strong class="bar-seconds">{item.seconds}s</strong>
              <span class="bar-status-tag">{item.status}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="chart-insight-box">
      <strong>Critical Takeaway for Founders:</strong>
      <p>Investors spend nearly 70% of their total cognitive reading time on just two sections: <em>Business Model</em> (83s) and <em>Product Architecture</em> (77s). Decks that rush or obscure these two slides face an 82% higher drop-off rate before reaching the team slide.</p>
    </div>
  </div>

  <!-- Panel 2: Point Nine SaaS Animal Sizing -->
  <div class="chart-panel" id="panel-chart-animals" role="tabpanel" aria-labelledby="tab-chart-animals" hidden>
    <div class="panel-intro-bar">
      <div>
        <h4>Christoph Janz's 5 Ways to Build a $100M SaaS Business</h4>
        <p>Calculate your customer count requirement based on Average Contract Value (ACV).</p>
      </div>
      <div class="benchmark-pill">
        <span>Target: <strong>$100M ARR</strong></span>
        <span>Framework: <strong>Point Nine Capital</strong></span>
      </div>
    </div>

    <div class="animals-grid" data-ui>
      {animalData.map(item => (
        <div class="animal-card">
          <div class="animal-top">
            <span class="animal-category">{item.share}</span>
            <strong class="animal-title">{item.animal}</strong>
          </div>
          <div class="animal-metrics-row">
            <div>
              <span class="animal-metric-lbl">Target ACV</span>
              <strong class="animal-metric-val">{item.acv}</strong>
            </div>
            <div>
              <span class="animal-metric-lbl">Required Buyers</span>
              <strong class="animal-metric-val">{item.count}</strong>
            </div>
          </div>
          <p class="animal-model-desc">{item.model}</p>
        </div>
      ))}
    </div>

    <div class="chart-insight-box">
      <strong>Critical Takeaway for Founders:</strong>
      <p>Your sales model must mathematically match your ACV. If your ACV is $1,000 (Rabbits), you cannot afford field sales representatives ($150k OTE). If your ACV is $100,000 (Elephants), self-serve signups without an enterprise SDR will fail.</p>
    </div>
  </div>
</div>

<script>
  const chartTabs = document.querySelectorAll<HTMLButtonElement>('.chart-tab-btn');
  const panelHeatmap = document.getElementById('panel-chart-heatmap');
  const panelAnimals = document.getElementById('panel-chart-animals');

  chartTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const isHeatmap = tab.id === 'tab-chart-heatmap';
      chartTabs.forEach(t => {
        const active = t === tab;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });

      if (panelHeatmap) panelHeatmap.hidden = !isHeatmap;
      if (panelAnimals) panelAnimals.hidden = isHeatmap;
    });
  });
</script>

<style>
  .pitch-charts-component {
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 36px 32px;
    margin-block: 48px;
    color: var(--fg);
  }
  .charts-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 24px;
  }
  .charts-kicker {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    display: block;
    margin-bottom: 6px;
  }
  .charts-header h3 {
    font-size: 26px;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .charts-header p {
    font-size: 15px;
    color: var(--fg-2);
    max-width: 54ch;
    line-height: 1.5;
  }

  .chart-tab-controls {
    display: flex;
    background: #141615;
    padding: 4px;
    border-radius: var(--radius-xs);
    gap: 4px;
  }
  .chart-tab-btn {
    border: 0;
    background: transparent;
    color: var(--fg-3);
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
  }
  .chart-tab-btn:hover {
    color: var(--fg);
  }
  .chart-tab-btn.active {
    background: var(--bg-elevated);
    color: var(--fg);
    font-weight: 500;
  }

  .chart-panel {
    padding-top: 32px;
  }
  .panel-intro-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 28px;
  }
  .panel-intro-bar h4 {
    font-size: 20px;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin-bottom: 4px;
  }
  .panel-intro-bar p {
    font-size: 14px;
    color: var(--fg-2);
  }
  .benchmark-pill {
    display: flex;
    gap: 16px;
    background: #141615;
    padding: 10px 16px;
    border-radius: var(--radius-xs);
    font-size: 13px;
    color: var(--fg-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .benchmark-pill strong {
    color: var(--accent);
  }

  /* Heatmap list */
  .heatmap-bars-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .heatmap-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: center;
    background: #141615;
    padding: 14px 18px;
    border-radius: var(--radius-xs);
  }
  .row-label-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row-section-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
  }
  .row-note {
    font-size: 13px;
    color: var(--fg-3);
  }
  .bar-track-wrap {
    display: grid;
    grid-template-columns: 1fr 140px;
    gap: 16px;
    align-items: center;
  }
  .bar-fill-track {
    background: var(--bg-raised);
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
  }
  .bar-fill-progress {
    background: var(--accent);
    height: 100%;
    border-radius: 6px;
    transition: width 0.3s var(--ease);
  }
  .bar-metrics {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-variant-numeric: tabular-nums;
  }
  .bar-seconds {
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
  }
  .bar-status-tag {
    font-size: 13px;
    color: var(--fg-3);
  }

  /* Animals Grid */
  .animals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .animal-card {
    background: #141615;
    padding: 20px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .animal-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .animal-category {
    font-size: 13px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .animal-title {
    font-size: 20px;
    color: var(--fg);
    font-weight: 500;
  }
  .animal-metrics-row {
    display: flex;
    justify-content: space-between;
    background: var(--bg-raised);
    padding: 10px 12px;
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
  }
  .animal-metric-lbl {
    font-size: 13px;
    color: var(--fg-3);
    display: block;
  }
  .animal-metric-val {
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
  }
  .animal-model-desc {
    font-size: 13px;
    color: var(--fg-2);
    line-height: 1.5;
  }

  .chart-insight-box {
    margin-top: 24px;
    background: #141615;
    padding: 16px 20px;
    border-radius: var(--radius-xs);
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.6;
    border-left: 2px solid var(--accent);
  }
  .chart-insight-box strong {
    color: var(--fg);
    display: block;
    margin-bottom: 4px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 860px) {
    .charts-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .heatmap-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .panel-intro-bar {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
