---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: 'home' | 'pitch' | 'bos';
}

const {
  title = "Andromeda | Next-Gen B2B Platform & Operating System",
  description = "Andromeda B2B Platform - Decoupled static front-end powered by Astro and Convex reactive backend. Featuring B2B solutions, Startups Pitch, and BOS operations console.",
  activePage = 'home'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Cloudflare Edge & Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <div class="cosmic-grid" aria-hidden="true"></div>
    <div class="cosmic-glow-top" aria-hidden="true"></div>
    
    <Navbar activePage={activePage} />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <style>
      .cosmic-glow-top {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 1000px;
        height: 400px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(6, 182, 212, 0.08) 40%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      #main-content {
        flex: 1;
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
